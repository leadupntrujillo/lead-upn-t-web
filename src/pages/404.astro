---
import Layout from '../layouts/Layout.astro';

/** Página no encontrada. */
---

<Layout titulo="Página no encontrada" descripcion="La página que buscas no existe o cambió de dirección." noindex>
	<section class="error">
		<span class="error__fondo titulo" aria-hidden="true">404</span>
		<div class="contenedor error__fila">
			<div class="error__texto">
				<p class="kicker">Error 404</p>
				<h1 class="titulo">Esta página despegó <span class="caja">sin nosotros</span></h1>
				<p class="error__bajada">El enlace puede estar roto o la página cambió de lugar. Volvamos a la órbita.</p>
				<div class="error__acciones">
					<a class="btn btn--primario" href="/">Ir al inicio</a>
					<a class="btn btn--borde" href="/novedades">Ver novedades</a>
				</div>
			</div>
			<img
				class="error__auki"
				src="/estados_web/auki-404-800.webp"
				srcset="/estados_web/auki-404-480.webp 480w, /estados_web/auki-404-800.webp 800w"
				sizes="(min-width: 60rem) 28rem, 85vw"
				width="800"
				height="800"
				alt="Auki, con cara de confusión, junto a un letrero de página no encontrada"
			/>
		</div>
	</section>
</Layout>

<style>
	.error {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(60% 90% at 100% 100%, rgb(140 63 209 / 0.35), transparent 60%),
			var(--noche);
		color: var(--blanco);
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3.5rem, 8vw, 6rem);
	}
	/* Número gigante de contorno, solo decorativo */
	.error__fondo {
		position: absolute;
		left: -1.25rem;
		bottom: -5rem;
		font-size: clamp(14rem, 45vw, 32.5rem);
		line-height: 1;
		color: transparent;
		-webkit-text-stroke: 2px rgb(179 148 244 / 0.18);
		pointer-events: none;
		user-select: none;
	}
	.error__fila {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 3rem;
	}
	.error__texto {
		flex: 1 1 30rem;
		display: grid;
		gap: 1.5rem;
		justify-items: start;
	}
	.error .kicker {
		color: var(--blanco);
	}
	h1 {
		font-size: clamp(3.5rem, 7vw, 6.5rem);
		line-height: 0.98;
		text-wrap: wrap;
	}
	.error__bajada {
		font-size: 1.1875rem;
		color: var(--morado-claro);
		max-width: 29rem;
	}
	.error__acciones {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	.error__auki {
		flex: 1 1 22rem;
		width: min(100%, 28.75rem);
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 2rem;
		transform: rotate(3deg);
		box-shadow: 0 30px 60px rgb(0 0 0 / 0.4);
	}
	@media (max-width: 40rem) {
		.error__fila {
			gap: 2.5rem;
		}
		.error__auki {
			flex-basis: auto;
			max-width: 22rem;
			margin-inline: auto;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.error__auki {
			transform: none;
		}
	}
</style>

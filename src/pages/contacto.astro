---
import Layout from '../layouts/Layout.astro';
import { getSitio } from '../lib/queries';
import { migas } from '../lib/seo';

// Íconos de trazo simple (24×24), los mismos del pie de página.
const ICONOS: Record<string, string> = {
	correo: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
	whatsapp: '<path d="M4 20l1.2-3.9A8 8 0 1 1 8 19.1z"/>',
	instagram:
		'<rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/>',
	linkedin:
		'<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6c0-1.7 1-2.9 2.5-2.9S17 11.7 17 13.4V17M12 10.5V17"/>',
	tiktok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.3 2.6 2 4.4 5 4.7"/>',
	facebook: '<path d="M14.5 21v-7.5h2.6l.4-3h-3V8.7c0-.9.3-1.5 1.6-1.5h1.5V4.5c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.2H9v3h2.5V21"/>',
};

/**
 * Contacto: los canales oficiales de la tabla "Sitio" (correo, WhatsApp y redes). Sin formulario por ahora.
 */
const sitio = await getSitio();
const canales = [
	sitio.correo && { clave: 'correo', nombre: 'Correo', valor: sitio.correo, href: `mailto:${sitio.correo}`, nota: 'Para alianzas, prensa y consultas.' },
	sitio.redes.whatsapp && { clave: 'whatsapp', nombre: 'WhatsApp', valor: 'Escríbenos', href: sitio.redes.whatsapp, nota: 'La forma más rápida de resolver dudas.' },
	sitio.redes.instagram && {
		clave: 'instagram',
		nombre: 'Instagram',
		valor: '@' + (sitio.redes.instagram.split('instagram.com/')[1] ?? 'leadupn_trujillo').replace(/\/.*/, ''),
		href: sitio.redes.instagram,
		nota: 'Convocatorias, eventos y el día a día de LEAD.',
	},
	sitio.redes.linkedin && { clave: 'linkedin', nombre: 'LinkedIn', valor: 'LEAD UPN Trujillo', href: sitio.redes.linkedin, nota: 'Logros y alianzas.' },
	sitio.redes.tiktok && { clave: 'tiktok', nombre: 'TikTok', valor: 'LEAD UPN Trujillo', href: sitio.redes.tiktok, nota: '' },
	sitio.redes.facebook && { clave: 'facebook', nombre: 'Facebook', valor: 'LEAD UPN Trujillo', href: sitio.redes.facebook, nota: '' },
].filter((c): c is { clave: string; nombre: string; valor: string; href: string; nota: string } => Boolean(c));
---

<Layout
	titulo="Contacto"
	descripcion="Escríbenos o síguenos en redes: canales oficiales de LEAD UPN Trujillo."
	jsonLd={[
		migas([
			{ nombre: 'Inicio', ruta: '/' },
			{ nombre: 'Contacto', ruta: '/contacto' },
		]),
	]}
>
	<div class="contenedor contacto">
		<header class="contacto__intro">
			<p class="kicker">Contacto</p>
			<h1 class="titulo">Hablemos<span class="contacto__punto">.</span></h1>
			<p class="contacto__bajada">
				Escríbenos por el canal que prefieras. Para alianzas y prensa, el correo es lo mejor; para dudas rápidas, WhatsApp.
			</p>
		</header>

		<ul class="canales" aria-label="Canales">
			{
				canales.map((c) => (
					<li>
						<a class="canal" href={c.href} data-cta={`contacto-${c.nombre.toLowerCase()}`} {...(c.href.startsWith('http') ? { rel: 'noopener noreferrer', target: '_blank' } : {})}>
							<span class={`canal__ico${c.clave === 'whatsapp' ? ' canal__ico--degradado' : ''}`} aria-hidden="true">
								<svg viewBox="0 0 24 24" set:html={ICONOS[c.clave]} />
							</span>
							<span class="canal__texto">
								<span class="canal__nombre">{c.nombre}</span>
								<strong class="canal__valor titulo">{c.valor}</strong>
								{c.nota && <span class="canal__nota">{c.nota}</span>}
							</span>
							<span class="canal__ir flechas" aria-hidden="true" />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Layout>

<style>
	.contacto {
		display: flex;
		flex-wrap: wrap;
		gap: 4rem;
		padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3.5rem, 8vw, 7rem);
	}
	.contacto__intro {
		flex: 1 1 24rem;
		display: grid;
		gap: 1.4rem;
		align-content: start;
	}
	.contacto__intro h1 {
		font-size: clamp(4rem, 8vw, 7.5rem);
		line-height: 1;
	}
	.contacto__punto {
		color: var(--magenta);
	}
	.contacto__bajada {
		max-width: 26rem;
		font-size: 1.1875rem;
		color: var(--tinta-suave);
	}
	.canales {
		flex: 2 1 35rem;
		min-width: 0;
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 2px solid var(--marino);
	}
	.canal {
		display: grid;
		grid-template-columns: 4rem 1fr auto;
		gap: 1.5rem;
		align-items: center;
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--linea);
		text-decoration: none;
	}
	.canal__ico {
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		border-radius: 1.125rem;
		background: var(--marino);
		color: var(--blanco);
	}
	.canal__ico--degradado {
		background: var(--degradado-boton);
	}
	.canal__ico svg {
		width: 1.625rem;
		height: 1.625rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.canal__texto {
		display: grid;
		gap: 0.125rem;
		min-width: 0;
	}
	.canal__nombre {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--tinta-suave);
	}
	.canal__valor {
		font-size: clamp(1.5rem, 5.5vw, 2.25rem);
		line-height: 1.05;
		overflow-wrap: anywhere;
	}
	.canal__nota {
		font-size: 0.9375rem;
		color: var(--tinta-suave);
	}
	.canal__ir {
		color: var(--magenta);
		font-weight: 700;
		transition: transform 0.2s;
	}
	.canal__ir::after {
		margin-left: 0;
	}
	.canal:hover .canal__ir {
		transform: translateX(6px);
	}
	@media (max-width: 40rem) {
		.contacto {
			gap: 2.5rem;
		}
		.canal {
			grid-template-columns: 3.25rem 1fr auto;
			gap: 1rem;
			padding-block: 1.25rem;
		}
		.canal__ico {
			width: 3.25rem;
			height: 3.25rem;
			border-radius: 0.9rem;
		}
		.canal__ico svg {
			width: 1.375rem;
			height: 1.375rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.canal:hover .canal__ir {
			transform: none;
		}
	}
</style>

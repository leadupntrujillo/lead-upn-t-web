---
import ListaPilares from '../components/ListaPilares.astro';
import NovedadCard from '../components/NovedadCard.astro';
import Unete from '../components/Unete.astro';
import Layout from '../layouts/Layout.astro';
import { partesDeFecha } from '../lib/format';
import { proximos } from '../lib/novedades';
import { FORMATOS_INFO } from '../lib/notion/formatos';
import { getAliados, getCifras, getNovedades, getPilares, getPilaresPorId, getPortada, getTestimonios } from '../lib/queries';

const [novedades, portada, pilares, pilaresPorId, cifras, testimonios, aliados] = await Promise.all([
	getNovedades(),
	getPortada(),
	getPilares(),
	getPilaresPorId(),
	getCifras(),
	getTestimonios(),
	getAliados(),
]);

const { principal, destacadas, recientes } = portada;
const masNovedades = [...destacadas, ...recientes].slice(0, 6);
const fechas = proximos(novedades).slice(0, 3);
const pilarDe = (n: (typeof novedades)[number]) => (n.data.pilar ? pilaresPorId.get(n.data.pilar.id) : undefined);

const numero = (c: (typeof cifras)[number]) => `${c.data.prefijo}${c.data.valor.toLocaleString('es-PE')}${c.data.sufijo}`;

const lema = [
	{ palabra: 'Learn', color: 'var(--coral-claro)' },
	{ palabra: 'Explore', color: 'var(--magenta-claro)' },
	{ palabra: 'Aspire', color: 'var(--morado-claro)' },
	{ palabra: 'Discover.', color: 'var(--blanco)' },
];
---

<Layout>
	<!-- Hero: el lema de LEAD y Auki despegando -->
	<section class="hero">
		<div class="hero__arte" aria-hidden="true">
			<img
				src="/brand/auki-cohete.webp"
				srcset="/brand/auki-cohete-640.webp 640w, /brand/auki-cohete.webp 1100w"
				sizes="(max-width: 48rem) 100vw, 66vw"
				alt=""
				width="1100"
				height="692"
				fetchpriority="high"
			/>
		</div>
		<div class="contenedor hero__contenido">
			<h1 class="lema titulo">
				<span class="sr-only">LEAD UPN Trujillo: </span>
				{lema.map((l, i) => <span class="lema__linea" style={`--c:${l.color};--i:${i}`}>{l.palabra}</span>)}
			</h1>
			<p class="hero__texto">
				Somos la organización estudiantil de liderazgo con propósito de la UPN en Trujillo. Aprende, explora y descubre
				con nosotros.
			</p>
			<div class="hero__acciones">
				<a class="btn btn--primario" href="/novedades">Ver novedades</a>
				<a class="btn btn--borde" href="#pilares">Conoce los pilares</a>
			</div>
		</div>
	</section>

	<!-- Lo último -->
	<section class="seccion contenedor" aria-labelledby="t-novedades">
		<div class="seccion__cabeza">
			<h2 id="t-novedades" class="seccion__titulo titulo">Novedades</h2>
			<a class="seccion__enlace flechas" href="/novedades">Ver todas</a>
		</div>

		{
			principal ? (
				<div class="portada">
					<NovedadCard entry={principal} pilar={pilarDe(principal)} variante="grande" />
					{masNovedades.length > 0 && (
						<ul class="portada__grilla">
							{masNovedades.map((n) => (
								<li>
									<NovedadCard entry={n} pilar={pilarDe(n)} />
								</li>
							))}
						</ul>
					)}
				</div>
			) : (
				<p class="vacio">Todavía no hay novedades publicadas. Vuelve pronto.</p>
			)
		}
	</section>

	<!-- Próximas fechas -->
	{
		fechas.length > 0 && (
			<section class="seccion contenedor" aria-labelledby="t-fechas">
				<div class="seccion__cabeza">
					<h2 id="t-fechas" class="seccion__titulo titulo">Próximas fechas</h2>
				</div>
				<ol class="fechas">
					{fechas.map((n) => {
						const ev = n.data.fechaEvento!;
						const p = partesDeFecha(ev.inicio, ev.conHora);
						return (
							<li>
								<a class="fecha" href={`/novedades/${n.id}`}>
									<span class="fecha__hoja" aria-hidden="true">
										<span class="fecha__dia">{p.dia}</span>
										<span class="fecha__mes">{p.mes}</span>
									</span>
									<span class="fecha__texto">
										<span class="fecha__titulo">{n.data.titulo}</span>
										<span class="fecha__meta">
											{[n.data.formato === 'convocatoria' ? 'Fecha límite' : FORMATOS_INFO[n.data.formato].nombre, n.data.lugar?.nombre]
												.filter(Boolean)
												.join(', ')}
										</span>
									</span>
									<span class="fecha__ir flechas" aria-hidden="true" />
								</a>
							</li>
						);
					})}
				</ol>
			</section>
		)
	}

	<!-- Cifras -->
	{
		cifras.length > 0 && (
			<section class="cifras" aria-labelledby="t-cifras">
				<div class="contenedor">
					<h2 id="t-cifras" class="sr-only">LEAD en cifras</h2>
					<ul class="cifras__lista">
						{cifras.map((c) => (
							<li>
								<span class="cifras__valor">{numero(c)}</span>
								<span class="cifras__nombre">{c.data.nombre}</span>
								{c.data.descripcion && c.data.descripcion !== c.data.nombre && (
									<span class="cifras__desc">{c.data.descripcion}</span>
								)}
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<!-- Pilares -->
	<section id="pilares" class="seccion contenedor" aria-labelledby="t-pilares">
		<div class="seccion__cabeza">
			<h2 id="t-pilares" class="seccion__titulo titulo">Nuestros pilares</h2>
		</div>
		<ListaPilares {pilares} {novedades} />
	</section>

	<!-- Testimonios -->
	{
		testimonios.length > 0 && (
			<section class="seccion contenedor" aria-labelledby="t-testimonios">
				<div class="seccion__cabeza">
					<h2 id="t-testimonios" class="seccion__titulo titulo">Lo que dicen nuestros miembros</h2>
				</div>
				<ul class="testimonios">
					{testimonios.map((t) => (
						<li>
							<blockquote>{t.data.frase || t.data.testimonio}</blockquote>
							<p class="testimonio__autor">
								{t.data.foto && <img src={t.data.foto.src} alt="" width="48" height="48" loading="lazy" />}
								<span>
									<strong>{t.data.nombre}</strong>
									<span>{[t.data.carrera, t.data.rol].filter(Boolean).join(', ')}</span>
								</span>
							</p>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<!-- Aliados -->
	{
		aliados.length > 0 && (
			<section class="seccion contenedor" aria-labelledby="t-aliados">
				<div class="seccion__cabeza">
					<h2 id="t-aliados" class="seccion__titulo titulo">Aliados</h2>
				</div>
				<ul class="aliados">
					{aliados.map((a) => (
						<li>
							{a.data.sitioWeb ? (
								<a href={a.data.sitioWeb} rel="noopener noreferrer" target="_blank" aria-label={a.data.nombre}>
									{a.data.logo ? <img src={a.data.logo.src} alt={a.data.nombre} loading="lazy" /> : a.data.nombre}
								</a>
							) : a.data.logo ? (
								<img src={a.data.logo.src} alt={a.data.nombre} loading="lazy" />
							) : (
								<span>{a.data.nombre}</span>
							)}
						</li>
					))}
				</ul>
			</section>
		)
	}

	<!-- Súmate -->
	<Unete />
</Layout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background:
			radial-gradient(60% 90% at 0% 100%, rgb(214 41 122 / 0.22), transparent 60%),
			var(--noche);
		color: var(--blanco);
		min-height: min(46rem, 88dvh);
		display: grid;
		align-items: center;
	}
	.hero__arte {
		position: absolute;
		inset: 0 0 0 auto;
		width: min(66%, 62rem);
		z-index: -1;
		-webkit-mask-image: linear-gradient(to right, transparent 0%, #000 42%);
		mask-image: linear-gradient(to right, transparent 0%, #000 42%);
	}
	.hero__arte img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 62% 40%;
	}
	.hero__contenido {
		display: grid;
		gap: 1.75rem;
		justify-items: start;
		padding-block: clamp(3rem, 9vw, 6rem);
	}
	.lema {
		display: grid;
		font-size: clamp(3.6rem, 11.5vw, 8.5rem);
		line-height: 0.98;
	}
	.lema__linea {
		display: block;
		color: var(--c);
		/* Único movimiento de la portada: las cuatro palabras entran una tras otra */
		animation: entra 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		animation-delay: calc(var(--i) * 110ms);
	}
	@keyframes entra {
		from {
			opacity: 0;
			transform: translateY(0.35em);
		}
	}
	.hero__texto {
		max-width: 30rem;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.6;
		color: rgb(255 255 255 / 0.9);
	}
	.hero__acciones {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	@media (max-width: 48rem) {
		.hero__arte {
			width: 100%;
			opacity: 0.4;
			-webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
			mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
		}
	}

	/* ---------- Novedades ---------- */
	.portada {
		display: grid;
		gap: 1.5rem;
	}
	.portada__grilla {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		align-items: start;
	}

	/* ---------- Próximas fechas ---------- */
	.fechas {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}
	.fecha {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1rem 1.25rem;
		background: var(--blanco);
		border-radius: 1rem;
		box-shadow: var(--sombra);
		text-decoration: none;
		transition: transform 0.2s;
	}
	.fecha:hover {
		transform: translateX(4px);
	}
	.fecha__hoja {
		display: grid;
		justify-items: center;
		min-width: 4rem;
		padding: 0.5rem 0.6rem;
		border-radius: 0.75rem;
		background: var(--marino);
		color: var(--blanco);
		line-height: 1;
	}
	.fecha__dia {
		font-family: var(--f-display);
		font-size: 2rem;
	}
	.fecha__mes {
		margin-top: 0.2rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--coral-claro);
	}
	.fecha__texto {
		display: grid;
		flex: 1;
		min-width: 0;
	}
	.fecha__titulo {
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1.3;
	}
	.fecha__meta {
		font-size: 0.875rem;
		color: var(--tinta-suave);
	}
	.fecha__ir {
		color: var(--magenta);
		font-weight: 700;
	}

	/* ---------- Cifras ---------- */
	.cifras {
		background: var(--marino);
		color: var(--blanco);
		padding-block: clamp(2.5rem, 6vw, 4rem);
	}
	.cifras__lista {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2rem;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
	}
	.cifras__lista li {
		display: grid;
		gap: 0.25rem;
		align-content: start;
		padding-top: 1rem;
		border-top: 4px solid transparent;
		border-image: var(--degradado) 1;
	}
	.cifras__valor {
		font-family: var(--f-display);
		font-size: clamp(3.5rem, 8vw, 5.5rem);
		line-height: 1;
	}
	.cifras__nombre {
		font-weight: 600;
	}
	.cifras__desc {
		font-size: 0.875rem;
		color: rgb(255 255 255 / 0.7);
	}

	/* ---------- Testimonios y aliados ---------- */
	.testimonios {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
	}
	.testimonios li {
		display: grid;
		gap: 1.25rem;
		align-content: space-between;
		padding: 1.5rem;
		background: var(--blanco);
		border-radius: 1rem;
		box-shadow: var(--sombra);
	}
	.testimonios blockquote {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.5;
	}
	.testimonio__autor {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 0.9rem;
	}
	.testimonio__autor img {
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		object-fit: cover;
	}
	.testimonio__autor > span {
		display: grid;
		color: var(--tinta-suave);
	}
	.testimonio__autor strong {
		color: var(--tinta);
	}
	.aliados {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem 3rem;
	}
	.aliados img {
		height: 3rem;
		width: auto;
		max-width: 10rem;
		object-fit: contain;
	}

</style>

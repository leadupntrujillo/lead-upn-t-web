---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Metrics from "../components/Metrics.astro";
import CtaButtons from "../components/CtaButtons.astro";
import Events from "../components/Events.astro";
import TechPaw from "../components/TechPaw.astro";
---

<Layout title="LEAD UPN Trujillo - Learn, Explore, Aspire, Discover">
  <Header />

  <main>
    <!-- HERO SECTION -->
    <section class="hero" aria-label="Hero Section">
      <div class="hero-grid">
        <!-- Content Left -->
        <div class="hero-content">
          <h1 class="main-title">
            Donde el talento <span class="highlight cyan">STEM</span><br /> encuentra
            su <span class="highlight gold">liderazgo.</span>
          </h1>
          <p class="hero-description">
            Únete a la nueva generación de creadores. Un espacio diseñado para
            conectar tu pasión por la ingeniería y el desarrollo con el
            crecimiento profesional. Colabora, aprende y construye soluciones
            que impactan. Tu camino hacia la excelencia tecnológica comienza
            aquí.
          </p>
          <div class="hero-cta-wrapper">
            <a href="/unete" class="btn-hero">
              <span>Únete a la comunidad</span>
            </a>
          </div>
        </div>

        <!-- Animation Wrapper Right -->
        <div class="hero-animation-wrapper" id="hero-animation-container">
          <TechPaw />
        </div>
      </div>
    </section>

    <!-- METRICS -->
    <Metrics />

    <!-- SECONDARY CTAs -->
    <CtaButtons />

    <!-- EVENTS -->
    <Events />
  </main>

  <footer class="footer crystal-fx">
    <div class="footer-content">
      <p>&copy; 2026 LEAD UPN Trujillo. Todos los derechos reservados.</p>
    </div>
  </footer>
</Layout>

<script>
  // Simple scroll padding para anchors si se usan después
  document.documentElement.style.setProperty("--scroll-padding", "80px");
</script>

<style>
  main {
    max-width: 1440px;
    margin: 0 auto;
    padding-bottom: var(--space-8);
  }

  .hero {
    min-height: 75vh;
    display: flex;
    align-items: center;
    padding: var(--space-6) var(--space-4);
    position: relative;
    z-index: 10;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  .hero-content {
    text-align: left;
    animation: fade-right 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fade-right {
    from {
      opacity: 0;
      transform: translateX(-40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .hero-animation-wrapper {
    width: 100%;
    height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fade-left 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fade-left {
    from {
      opacity: 0;
      transform: translateX(40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .main-title {
    font-size: clamp(36px, 5vw, 68px);
    line-height: 1.15;
    margin-bottom: var(--space-4);
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .highlight {
    display: inline-block;
  }

  .highlight.cyan {
    color: var(--cyan);
    text-shadow: 0 0 20px rgba(42, 246, 255, 0.4);
  }
  .highlight.gold {
    color: var(--gold);
    text-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
  }

  .hero-description {
    font-size: clamp(16px, 1.5vw, 18px);
    color: var(--text-body);
    max-width: 550px;
    margin: 0 0 var(--space-4) 0;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-cta-wrapper {
    display: flex;
    gap: var(--space-3);
  }

  .btn-hero {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    background: linear-gradient(135deg, var(--cyan), var(--gold));
    color: var(--bg-deep);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    border-radius: 50px;
    text-decoration: none;
    letter-spacing: 1px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 30px rgba(42, 246, 255, 0.3);
    position: relative;
    overflow: hidden;
  }

  .btn-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--gold), var(--cyan));
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
  }

  .btn-hero span {
    position: relative;
    z-index: 2;
  }

  .btn-hero:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(42, 246, 255, 0.4);
    color: var(--bg-deep);
  }

  .btn-hero:hover::after {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-content {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .hero-description {
      text-align: center;
      margin: 0 auto var(--space-4) auto;
    }
    .hero-animation-wrapper {
      height: 400px;
    }
  }

  .footer {
    border-radius: 0; /* Reset border radius for footer */
    border-bottom: none;
    border-left: none;
    border-right: none;
    padding: var(--space-4) var(--space-3);
    text-align: center;
    margin-top: var(--space-6);
  }

  .footer-content p {
    font-size: 14px;
    opacity: 0.7;
  }

  /* Focus rings for main level components */
  :focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 4px;
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getEquipo, getPilares, getSitio } from '../lib/queries';
import { colorPilar } from '../lib/pilares';
import { migas } from '../lib/seo';

/**
 * Equipo: solo miembros con "Mostrar en la web", agrupados por su primer pilar.
 * Sin "Autoriza uso de imagen" no hay foto (la colección ya la deja en null): se muestran las iniciales.
 */
const [equipo, pilares, sitio] = await Promise.all([getEquipo(), getPilares(), getSitio()]);

const iniciales = (n: string) =>
	n
		.split(/\s+/)
		.slice(0, 2)
		.map((p) => p[0]?.toUpperCase() ?? '')
		.join('');
const url = (v: string | null, base: string) => (v ? (/^https?:/.test(v) ? v : base + v.replace(/^@/, '')) : null);

type Miembro = CollectionEntry<'miembros'>;
interface Grupo {
	id: string;
	nombre: string;
	color: string | null;
	miembros: Miembro[];
}

// Un grupo por pilar (en el orden de Notion). Quien no tiene pilar va primero, en "Coordinación".
const sinPilar: Grupo = { id: 'general', nombre: 'Coordinación', color: null, miembros: [] };
const porPilar = new Map<string, Grupo>(
	pilares.map((p) => [p.id, { id: p.id, nombre: p.data.nombre, color: colorPilar(p.data.color), miembros: [] }]),
);
for (const m of equipo) {
	const grupo = (m.data.pilares[0] && porPilar.get(m.data.pilares[0].id)) || sinPilar;
	grupo.miembros.push(m);
}
const grupos = [sinPilar, ...porPilar.values()].filter((g) => g.miembros.length > 0);

const externo = /^https?:/.test(sitio.unete.url);

const ICONOS = {
	instagram:
		'<rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/>',
	linkedin:
		'<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6c0-1.7 1-2.9 2.5-2.9S17 11.7 17 13.4V17M12 10.5V17"/>',
	web: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>',
};
---

<Layout
	titulo="Equipo"
	descripcion="Las personas que hacen LEAD UPN Trujillo: coordinadores y líderes de cada pilar."
	jsonLd={[
		migas([
			{ nombre: 'Inicio', ruta: '/' },
			{ nombre: 'Equipo', ruta: '/equipo' },
		]),
	]}
>
	<header class="hero">
		<div class="contenedor hero__fila">
			<div class="hero__titulo">
				<p class="kicker">Equipo</p>
				<h1 class="titulo">La <span class="caja">familia</span> detrás</h1>
			</div>
			<p class="hero__bajada">
				Coordinadores y miembros que hacen que cada actividad despegue. Ordenados por pilar.
			</p>
		</div>
	</header>

	<section class="miembros contenedor" aria-label="Miembros del equipo">
		{
			grupos.length === 0 ? (
				<p class="vacio">Pronto presentaremos al equipo.</p>
			) : (
				grupos.map((g, i) => (
					<div class="grupo">
						<h2 class="grupo__nombre">
							{g.color && <i class="grupo__punto" style={`--punto:${g.color}`} aria-hidden="true" />}
							{g.nombre}
						</h2>
						<ul class="grupo__lista">
							{g.miembros.map((m, j) => {
								const redes = [
									{ n: 'Instagram', ico: ICONOS.instagram, h: url(m.data.instagram, 'https://www.instagram.com/') },
									{ n: 'LinkedIn', ico: ICONOS.linkedin, h: url(m.data.linkedin, 'https://www.linkedin.com/in/') },
									{ n: 'Sitio web', ico: ICONOS.web, h: m.data.web },
								].filter((r): r is { n: string; ico: string; h: string } => Boolean(r.h));
								const descripcion = [m.data.rol, m.data.bio].filter(Boolean).join(' · ');
								return (
									<li class="miembro">
										<div class="miembro__marco" style={`--giro:${j % 2 === 0 ? '-2deg' : '2deg'}`}>
											{m.data.foto ? (
												<img
													class="miembro__foto"
													src={m.data.foto.src}
													srcset={m.data.foto.srcset || undefined}
													sizes="(min-width: 48rem) 17rem, 70vw"
													width={m.data.foto.width ?? undefined}
													height={m.data.foto.height ?? undefined}
													alt={`Foto de ${m.data.nombre}`}
													loading="lazy"
													decoding="async"
												/>
											) : (
												<span class="miembro__iniciales titulo" aria-hidden="true">
													{iniciales(m.data.nombre)}
												</span>
											)}
										</div>
										<div class="miembro__texto">
											<h3 class="miembro__nombre titulo">{m.data.nombre}</h3>
											{m.data.cargo && <p class="miembro__cargo">{m.data.cargo}</p>}
											{descripcion && <p class="miembro__desc">{descripcion}</p>}
											{redes.length > 0 && (
												<ul class="miembro__redes" aria-label={`Redes de ${m.data.nombre}`}>
													{redes.map((r) => (
														<li>
															<a href={r.h} aria-label={`${r.n} de ${m.data.nombre}`} target="_blank" rel="noopener noreferrer">
																<svg viewBox="0 0 24 24" aria-hidden="true" set:html={r.ico} />
															</a>
														</li>
													))}
												</ul>
											)}
										</div>
									</li>
								);
							})}
							{i === grupos.length - 1 && (
								<li class="miembro">
									<a
										class="sumate"
										href={sitio.unete.url}
										data-cta="unete"
										{...(externo ? { rel: 'noopener noreferrer', target: '_blank' } : {})}
									>
										<span class="sumate__titulo titulo">
											Tu lugar<br />
											está aquí
										</span>
										<span class="sumate__texto flechas">Súmate a LEAD</span>
									</a>
								</li>
							)}
						</ul>
					</div>
				))
			)
		}
	</section>
</Layout>

<style>
	/* ---------- Hero ---------- */
	.hero {
		background: var(--marino);
		color: var(--blanco);
		padding-block: clamp(3rem, 7vw, 4.5rem) clamp(3.25rem, 8vw, 5rem);
	}
	.hero__fila {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem 2.5rem;
	}
	.hero__titulo {
		display: grid;
		gap: 1.1rem;
		justify-items: start;
	}
	.hero h1 {
		font-size: clamp(3.25rem, 9vw, 8.5rem);
		line-height: 1;
	}
	.hero__bajada {
		max-width: 26rem;
		font-size: clamp(1rem, 2vw, 1.125rem);
		color: var(--morado-claro);
	}

	/* ---------- Miembros ---------- */
	.miembros {
		display: grid;
		gap: 3.5rem;
		padding-block: clamp(2.75rem, 7vw, 4.5rem) clamp(3.5rem, 9vw, 6rem);
	}
	.grupo {
		display: grid;
		gap: 1.5rem;
	}
	.grupo__nombre {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--f-texto);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--tinta-suave);
	}
	.grupo__punto {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--punto);
	}
	.grupo__lista {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
		gap: 2.25rem 1.75rem;
	}
	.miembro {
		display: grid;
		gap: 1rem;
		align-content: start;
	}

	/* Foto con marco de polaroid; sin foto, cuadro marino con las iniciales */
	.miembro__marco {
		aspect-ratio: 4 / 5;
		border: 0.5rem solid var(--blanco);
		border-radius: 0.375rem;
		background: var(--marino);
		box-shadow: 0 18px 36px -18px rgb(22 26 78 / 0.5);
		transform: rotate(var(--giro, -2deg));
		overflow: hidden;
	}
	.miembro__foto {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.miembro__iniciales {
		display: grid;
		place-items: center;
		height: 100%;
		font-size: clamp(5rem, 9vw, 6.875rem);
		background: var(--degradado-vertical);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	/* El marco sin foto usa borde marino para que el degradado no tenga marco blanco */
	.miembro__marco:has(.miembro__iniciales) {
		border-color: var(--marino);
		border-radius: 0.375rem;
	}

	.miembro__texto {
		display: grid;
		gap: 0.25rem;
	}
	.miembro__nombre {
		font-size: 2.25rem;
		line-height: 1.05;
	}
	.miembro__cargo {
		font-weight: 600;
	}
	.miembro__desc {
		font-size: 0.875rem;
		color: var(--tinta-suave);
	}
	.miembro__redes {
		list-style: none;
		margin: 0.5rem 0 0;
		padding: 0;
		display: flex;
		gap: 0.6rem;
	}
	.miembro__redes a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--blanco);
		box-shadow: inset 0 0 0 1px var(--linea);
		color: var(--marino);
		transition: box-shadow 0.15s, color 0.15s;
	}
	.miembro__redes a:hover {
		color: var(--magenta);
		box-shadow: inset 0 0 0 2px var(--magenta);
	}
	.miembro__redes svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Tarjeta final: invitación a sumarse */
	.sumate {
		display: grid;
		place-content: center;
		gap: 0.75rem;
		aspect-ratio: 4 / 5;
		padding: 1.5rem;
		border: 2px dashed var(--morado-claro);
		border-radius: 1rem;
		text-align: center;
		text-decoration: none;
		transition: background-color 0.15s;
	}
	.sumate:hover {
		background: var(--lavanda);
	}
	.sumate__titulo {
		font-size: clamp(2.25rem, 4vw, 2.75rem);
		line-height: 0.95;
	}
	.sumate__texto {
		font-weight: 600;
		color: var(--magenta);
	}

	/* ---------- Móvil ---------- */
	@media (max-width: 40rem) {
		.miembros {
			gap: 2.5rem;
		}
		.grupo__lista {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		/* Una columna: la foto no necesita ocupar todo el ancho */
		.miembro__marco,
		.sumate {
			width: min(100%, 18rem);
		}
		.sumate {
			aspect-ratio: auto;
			width: 100%;
			padding-block: 2.5rem;
		}
		.miembro__nombre {
			font-size: 2rem;
		}
	}
</style>

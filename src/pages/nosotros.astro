---
import ListaPilares from '../components/ListaPilares.astro';
import Unete from '../components/Unete.astro';
import Layout from '../layouts/Layout.astro';
import { getPilares, getSitio } from '../lib/queries';
import { migas } from '../lib/seo';

const [sitio, pilares] = await Promise.all([getSitio(), getPilares()]);

// Misión y visión salen de la tabla "Sitio" de Notion. En local se avisa si faltan.
const bloques = [
	{ id: 'mision', etiqueta: 'Misión', texto: sitio.mision },
	{ id: 'vision', etiqueta: 'Visión', texto: sitio.vision },
].filter((b) => b.texto || import.meta.env.DEV);

const lema = ['Learn', 'Explore', 'Aspire', 'Discover'];

// "Cómo crecemos": las cuatro formas de aprender en LEAD (texto fijo del diseño; no viene de Notion).
const formas = [
	{ nombre: 'Webinars y ponencias', texto: 'Gente de la industria y de la academia que comparte cómo llegó a donde está.' },
	{ nombre: 'Talleres y retos', texto: 'De la oratoria al origami aeroespacial: habilidades que se practican, no solo se escuchan.' },
	{ nombre: 'Cine y charlas', texto: 'Espacios para conversar, debatir y conocernos fuera del aula.' },
	{ nombre: 'Comunidad', texto: 'Actividades recreativas para que nadie avance solo.' },
];
---

<Layout
	titulo="Nosotros"
	descripcion={sitio.mision || sitio.descripcion}
	jsonLd={[
		migas([
			{ nombre: 'Inicio', ruta: '/' },
			{ nombre: 'Nosotros', ruta: '/nosotros' },
		]),
	]}
>
	<header class:list={['cabeza', { 'cabeza--con-bloques': bloques.length > 0 }]}>
		<div class="contenedor cabeza__fila">
			<p class="cabeza__antetitulo">Nosotros</p>
			<h1 class="titulo">Liderazgo con <span class="caja">propósito</span></h1>
			<p class="cabeza__texto">{sitio.descripcion}</p>
			<ol class="siglas" aria-label="Qué significa LEAD">
				{
					lema.map((palabra) => (
						<li>
							<strong>{palabra[0]}</strong>{palabra.slice(1)}
						</li>
					))
				}
			</ol>
		</div>
	</header>

	{
		bloques.length > 0 && (
			<section class="contenedor proposito" aria-label="Misión y visión">
				{bloques.map((b) => (
					<article class:list={['proposito__bloque', `proposito__bloque--${b.id}`]} aria-labelledby={`t-${b.id}`}>
						<h2 id={`t-${b.id}`} class="proposito__etiqueta titulo">
							{b.etiqueta}
						</h2>
						{b.texto ? (
							<p class="proposito__texto">{b.texto}</p>
						) : (
							<p class="proposito__falta">
								Falta la {b.etiqueta} en la tabla “Sitio” de Notion. (Este aviso solo se ve en tu computadora.)
							</p>
						)}
					</article>
				))}
			</section>
		)
	}

	<section class="hacemos" aria-labelledby="t-hacemos">
		<div class="contenedor hacemos__fila">
			<div class="hacemos__cabeza">
				<p class="kicker">Cómo crecemos</p>
				<h2 id="t-hacemos" class="titulo">Aprender <span class="caja caja--marino">haciendo</span></h2>
			</div>
			<ul class="formas">
				{
					formas.map((f) => (
						<li class="forma">
							<h3 class="forma__nombre titulo">{f.nombre}</h3>
							<p class="forma__texto">{f.texto}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		sitio.historia && (
			<section class="seccion" aria-labelledby="t-historia">
				<div class="lectura">
					<h2 id="t-historia" class="seccion__titulo titulo">Nuestra historia</h2>
					<div class="prose" set:html={sitio.historia} />
				</div>
			</section>
		)
	}

	{
		pilares.length > 0 && (
			<section class="seccion contenedor" aria-labelledby="t-pilares">
				<div class="seccion__cabeza">
					<h2 id="t-pilares" class="seccion__titulo titulo">Nuestros pilares</h2>
				</div>
				<ListaPilares {pilares} />
			</section>
		)
	}

	<Unete />
</Layout>

<style>
	.cabeza {
		background:
			radial-gradient(70% 120% at 100% 0%, rgb(140 63 209 / 0.35), transparent 60%),
			var(--marino);
		color: var(--blanco);
		padding-block: clamp(3rem, 8vw, 5.5rem);
	}
	/* Deja espacio para que misión y visión monten sobre la cabecera */
	.cabeza--con-bloques {
		padding-bottom: clamp(4.5rem, 10vw, 7rem);
	}
	.cabeza__fila {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
	}
	.cabeza__antetitulo {
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--coral-claro);
	}
	.cabeza h1 {
		font-size: clamp(2.8rem, 9vw, 6rem);
		line-height: 1;
		max-width: 14ch;
	}
	.cabeza__texto {
		max-width: 40rem;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.6;
		color: rgb(255 255 255 / 0.88);
	}
	.siglas {
		list-style: none;
		margin: 0.5rem 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		font-size: 1rem;
		color: rgb(255 255 255 / 0.8);
	}
	.siglas strong {
		font-family: var(--f-display);
		font-weight: 400;
		font-size: 1.6rem;
		line-height: 1;
		color: var(--blanco);
		margin-right: 0.05em;
	}

	/* Misión y visión: dos bloques grandes que montan sobre la cabecera */
	.proposito {
		display: grid;
		gap: 1.25rem;
		margin-top: clamp(-4rem, -7vw, -2.5rem);
		position: relative;
	}
	@media (min-width: 52rem) {
		.proposito {
			grid-template-columns: 1fr 1fr;
		}
	}
	.proposito__bloque {
		display: grid;
		gap: 1rem;
		align-content: start;
		padding: clamp(1.5rem, 4vw, 2.5rem);
		border-radius: 1rem;
		background: var(--blanco);
		box-shadow: var(--sombra);
		position: relative;
		overflow: hidden;
	}
	/* Franja con el degradado de marca (con border-image se perderían las esquinas redondeadas) */
	.proposito__bloque::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 6px;
		background: var(--degradado);
	}
	.proposito__bloque--vision {
		background: var(--noche);
		color: var(--blanco);
	}
	.proposito__etiqueta {
		font-size: 1rem;
		letter-spacing: 0.12em;
		color: var(--magenta);
	}
	.proposito__bloque--vision .proposito__etiqueta {
		color: var(--magenta-claro);
	}
	.proposito__texto {
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		font-weight: 600;
		line-height: 1.5;
	}
	.proposito__falta {
		padding: 1rem;
		border: 2px dashed currentColor;
		border-radius: 0.6rem;
		font-size: 0.9rem;
		opacity: 0.75;
	}

	/* Aprender haciendo: franja blanca con cuatro columnas separadas por filetes */
	.hacemos {
		background: var(--blanco);
		margin-top: clamp(3rem, 8vw, 6rem);
		padding-block: clamp(3rem, 8vw, 6rem);
	}
	.hacemos__fila {
		display: grid;
		gap: clamp(1.75rem, 4vw, 2.5rem);
	}
	.hacemos__cabeza {
		display: grid;
		gap: 0.875rem;
		justify-items: start;
	}
	.hacemos h2 {
		font-size: clamp(2.75rem, 6vw, 5rem);
		line-height: 0.95;
	}
	.formas {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		border-top: 2px solid var(--marino);
	}
	.forma {
		display: grid;
		gap: 0.625rem;
		align-content: start;
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--linea);
	}
	.forma__nombre {
		font-size: clamp(1.625rem, 3vw, 1.875rem);
		line-height: 0.95;
		color: var(--morado);
	}
	.forma__texto {
		font-size: 0.9375rem;
		color: var(--tinta-suave);
	}
	@media (min-width: 40rem) {
		.formas {
			grid-template-columns: repeat(2, 1fr);
		}
		.forma:nth-child(even) {
			padding-left: 1.5rem;
			border-left: 1px solid var(--linea);
		}
		.forma:nth-child(odd) {
			padding-right: 1.5rem;
		}
	}
	@media (min-width: 64rem) {
		.formas {
			grid-template-columns: repeat(4, 1fr);
		}
		.forma,
		.forma:nth-child(odd),
		.forma:nth-child(even) {
			padding: 1.75rem 1.5rem;
			border-left: 1px solid var(--linea);
		}
		.forma:first-child {
			padding-left: 0;
			border-left: 0;
		}
		.forma:last-child {
			padding-right: 0;
		}
	}

	.lectura .seccion__titulo {
		margin-bottom: 1.25rem;
	}
</style>

---
import Layout from '../../layouts/Layout.astro';
import NovedadCard from '../../components/NovedadCard.astro';
import { FORMATOS_INFO } from '../../lib/notion/formatos';
import { colorPilar } from '../../lib/pilares';
import { getNovedades, getPilaresPorId } from '../../lib/queries';
import { migas } from '../../lib/seo';

const novedades = await getNovedades();
const pilares = await getPilaresPorId();

// Solo se ofrecen filtros que tienen resultados
const pilaresUsados = [...pilares.values()].filter((p) => novedades.some((n) => n.data.pilar?.id === p.id));
const formatosUsados = Object.entries(FORMATOS_INFO).filter(([id]) => novedades.some((n) => n.data.formato === id));
---

<Layout
	titulo="Novedades"
	descripcion="Noticias, eventos, convocatorias y anuncios de LEAD UPN Trujillo."
	jsonLd={[
		migas([
			{ nombre: 'Inicio', ruta: '/' },
			{ nombre: 'Novedades', ruta: '/novedades' },
		]),
	]}
>
	<header class="cabeza">
		<p class="cabeza__marca titulo" aria-hidden="true">Learn</p>
		<div class="contenedor cabeza__fila">
			<p class="kicker">01 · Learn</p>
			<h1 class="titulo">Novedades</h1>
			<p class="cabeza__bajada">
				Eventos, convocatorias, logros y todo lo que pasa en la familia LEAD UPN Trujillo.
			</p>
		</div>

		<section class="contenedor filtros" aria-label="Filtrar novedades">
			{
				formatosUsados.length > 1 && (
					<div class="filtros__grupo filtros__formatos" role="group" aria-label="Tipo">
						<a class="filtro" href="/novedades" data-todas>
							Todas
						</a>
						{formatosUsados.map(([id, info]) => (
							<a class="filtro" href={`?formato=${id}`} data-filtro="formato" data-valor={id}>
								{info.nombre}
							</a>
						))}
					</div>
				)
			}
			<div class="filtros__grupo filtros__pilares" role="group" aria-label="Pilar">
				{pilaresUsados.length > 1 && <span class="filtros__titulo">Pilar</span>}
				{
					pilaresUsados.length > 1 &&
						pilaresUsados.map((p) => (
							<a
								class="filtro-pilar"
								href={`?pilar=${p.data.slug}`}
								data-filtro="pilar"
								data-valor={p.data.slug}
								style={`--punto:${colorPilar(p.data.color)}`}
							>
								<span class="filtro-pilar__punto" aria-hidden="true" />
								{p.data.nombre}
							</a>
						))
				}
				<p class="conteo" role="status" aria-live="polite" data-conteo>
					{novedades.length === 1 ? '1 novedad' : `${novedades.length} novedades`}
				</p>
			</div>
			<p class="filtros__activo" data-etiqueta hidden>
				Etiqueta: <strong data-etiqueta-nombre></strong>
				<a href="/novedades">Quitar</a>
			</p>
		</section>
	</header>

	<div class="contenedor listado">
		{
			novedades.length > 0 ? (
				<ul class="grilla">
					{novedades.map((n) => (
						<li
							data-item
							data-pilar={n.data.pilar ? pilares.get(n.data.pilar.id)?.data.slug : ''}
							data-formato={n.data.formato}
							data-etiquetas={n.data.etiquetas.join('|')}
						>
							<NovedadCard entry={n} pilar={n.data.pilar ? pilares.get(n.data.pilar.id) : undefined} />
						</li>
					))}
				</ul>
			) : (
				<p class="vacio">Todavía no hay novedades publicadas. Vuelve pronto.</p>
			)
		}

		<p class="vacio" data-sin-resultados hidden>
			No hay novedades con estos filtros. <a href="/novedades">Quita los filtros</a> para ver todas.
		</p>
	</div>
</Layout>

<script>
	// Filtros sin recargar la página. Sin JavaScript los enlaces siguen funcionando como índice.
	type Clave = 'pilar' | 'formato' | 'etiqueta';
	const claves: Clave[] = ['pilar', 'formato', 'etiqueta'];
	const activo: Record<Clave, string | null> = { pilar: null, formato: null, etiqueta: null };

	const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
	const botones = [...document.querySelectorAll<HTMLAnchorElement>('[data-filtro]')];
	const todas = document.querySelector<HTMLAnchorElement>('[data-todas]');
	const conteo = document.querySelector<HTMLElement>('[data-conteo]');
	const sinResultados = document.querySelector<HTMLElement>('[data-sin-resultados]');
	const bloqueEtiqueta = document.querySelector<HTMLElement>('[data-etiqueta]');

	function leerUrl() {
		const params = new URLSearchParams(location.search);
		for (const c of claves) activo[c] = params.get(c);
	}

	function pintar() {
		let visibles = 0;
		for (const item of items) {
			const ok =
				(!activo.pilar || item.dataset.pilar === activo.pilar) &&
				(!activo.formato || item.dataset.formato === activo.formato) &&
				(!activo.etiqueta || (item.dataset.etiquetas ?? '').split('|').includes(activo.etiqueta));
			item.hidden = !ok;
			if (ok) visibles++;
		}
		// El filtro activo se marca con aria-current (los enlaces no admiten aria-pressed)
		for (const b of botones) {
			if (activo[b.dataset.filtro as Clave] === b.dataset.valor) b.setAttribute('aria-current', 'true');
			else b.removeAttribute('aria-current');
		}
		// "Todas" está activa cuando no hay filtro de formato
		if (todas) {
			if (!activo.formato) todas.setAttribute('aria-current', 'true');
			else todas.removeAttribute('aria-current');
		}
		if (conteo) conteo.textContent = visibles === 1 ? '1 novedad' : `${visibles} novedades`;
		if (sinResultados) sinResultados.hidden = visibles !== 0 || items.length === 0;
		if (bloqueEtiqueta) {
			bloqueEtiqueta.hidden = !activo.etiqueta;
			const nombre = bloqueEtiqueta.querySelector('[data-etiqueta-nombre]');
			if (nombre) nombre.textContent = activo.etiqueta ?? '';
		}
	}

	function guardarUrl() {
		const params = new URLSearchParams();
		for (const c of claves) if (activo[c]) params.set(c, activo[c]!);
		const query = params.toString();
		history.replaceState(null, '', query ? `?${query}` : location.pathname);
	}

	for (const b of botones) {
		b.addEventListener('click', (e) => {
			e.preventDefault();
			const c = b.dataset.filtro as Clave;
			activo[c] = activo[c] === b.dataset.valor ? null : (b.dataset.valor ?? null);
			guardarUrl();
			pintar();
		});
	}

	todas?.addEventListener('click', (e) => {
		e.preventDefault();
		activo.formato = null;
		guardarUrl();
		pintar();
	});

	leerUrl();
	pintar();
</script>

<style>
	/* ---------- Cabecera con filtros ---------- */
	.cabeza {
		position: relative;
		overflow: hidden;
		background: var(--marino);
		color: var(--blanco);
		padding-top: clamp(2.75rem, 7vw, 4.5rem);
	}
	/* Palabra del lema, enorme y casi invisible, de fondo */
	.cabeza__marca {
		position: absolute;
		right: -0.6rem;
		top: 0.6rem;
		font-size: clamp(8rem, 18vw, 17rem);
		line-height: 0.8;
		color: rgb(255 255 255 / 0.05);
		pointer-events: none;
		user-select: none;
	}
	.cabeza__fila {
		position: relative;
		display: grid;
		gap: 1.1rem;
		justify-items: start;
	}
	.cabeza .kicker {
		color: var(--blanco);
	}
	.cabeza h1 {
		font-size: clamp(3.5rem, 8vw, 7rem);
		line-height: 1;
	}
	.cabeza__bajada {
		max-width: 35rem;
		font-size: clamp(1rem, 2vw, 1.125rem);
		color: var(--morado-claro);
	}

	.filtros {
		position: relative;
		display: grid;
		gap: 0.9rem;
		margin-top: clamp(1.75rem, 5vw, 2.5rem);
		padding-block: 1.25rem 1.75rem;
		border-top: 1px solid rgb(255 255 255 / 0.12);
	}
	.filtros__grupo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	/* Formatos: pastillas translúcidas; la activa es blanca */
	.filtro {
		padding: 0.5rem 1.05rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.1);
		color: var(--blanco);
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition: background-color 0.15s;
	}
	.filtro:hover {
		background: rgb(255 255 255 / 0.2);
	}
	.filtro[aria-current='true'] {
		background: var(--blanco);
		color: var(--marino);
	}
	/* Pilares: enlaces con punto de color */
	.filtros__pilares {
		gap: 0.5rem 1.1rem;
		font-size: 0.8125rem;
		color: var(--morado-claro);
	}
	.filtros__titulo {
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.filtro-pilar {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding-block: 0.3rem;
		border-bottom: 2px solid transparent;
		font-weight: 600;
		color: var(--blanco);
		text-decoration: none;
	}
	.filtro-pilar:hover,
	.filtro-pilar[aria-current='true'] {
		border-bottom-color: var(--magenta-claro);
	}
	.filtro-pilar__punto {
		width: 0.7rem;
		height: 0.7rem;
		flex: none;
		border-radius: 50%;
		background: var(--punto);
		box-shadow: 0 0 0 2px rgb(255 255 255 / 0.25);
	}
	.filtros__activo {
		font-size: 0.9rem;
		color: var(--blanco);
	}
	.filtros__activo a {
		margin-left: 0.5rem;
		font-weight: 600;
		color: var(--magenta-claro);
	}
	.conteo {
		margin-left: auto;
		font-size: 0.8125rem;
		color: var(--morado-claro);
	}
	@media (max-width: 40rem) {
		/* En móvil los formatos se deslizan en una sola fila */
		.filtros__formatos {
			flex-wrap: nowrap;
			overflow-x: auto;
			margin-inline: calc(-1 * var(--gutter));
			padding-inline: var(--gutter);
			scrollbar-width: none;
		}
		.filtros__formatos::-webkit-scrollbar {
			display: none;
		}
	}

	.listado {
		padding-block: clamp(2.25rem, 6vw, 3.5rem) clamp(3.5rem, 8vw, 6rem);
		display: grid;
		gap: 1.25rem;
	}
	.grilla {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		align-items: start;
	}
	.grilla [data-item][hidden] {
		display: none;
	}
</style>

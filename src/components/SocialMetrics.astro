---
// SocialMetrics.astro
---

<section class="metrics-section">
  <div class="metrics-grid">
    <!-- WhatsApp -->
    <div class="metric-card crystal-fx">
      <div class="metric-icon wa">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
      </div>
      <div class="metric-info">
        <span class="metric-number">445+</span>
        <span class="metric-label">Miembros</span>
      </div>
    </div>

    <!-- Instagram -->
    <div class="metric-card crystal-fx">
      <div class="metric-icon ig">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
      </div>
      <div class="metric-info">
        <span class="metric-number">1,185</span>
        <span class="metric-label">Seguidores</span>
      </div>
    </div>

    <!-- LinkedIn -->
    <div class="metric-card crystal-fx">
      <div class="metric-icon in">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
      </div>
      <div class="metric-info">
        <span class="metric-number">130+</span>
        <span class="metric-label">Conexiones</span>
      </div>
    </div>
  </div>
</section>

<style>
  .metrics-section {
    padding: var(--space-2) var(--space-4) var(--space-6);
    display: flex;
    justify-content: center;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    width: 100%;
    max-width: 900px;
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    gap: var(--space-3);
    text-align: center;
  }

  .metric-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .metric-icon {
    width: 64px;
    height: 64px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .metric-icon.wa { color: #25D366; background: rgba(37, 211, 102, 0.1); }
  .metric-icon.ig { color: #E1306C; background: rgba(225, 48, 108, 0.1); }
  .metric-icon.in { color: #0077B5; background: rgba(0, 119, 181, 0.1); }

  .metric-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-number {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1;
  }

  .metric-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-body);
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .metrics-grid { grid-template-columns: 1fr; }
    .metric-card { flex-direction: row; justify-content: flex-start; padding: var(--space-4); gap: var(--space-4); }
    .metric-info { align-items: flex-start; }
  }
</style>

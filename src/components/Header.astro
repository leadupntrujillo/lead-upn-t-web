<!-- Header Wrapper -->
<header class="header-wrapper">
  <div class="header-block">
    <button
      class="menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <div class="hero-text-loop">
      <span class="loop-word active">LEARN</span>
      <span class="loop-word">EXPLORE</span>
      <span class="loop-word">ASPIRE</span>
      <span class="loop-word">DISCOVER</span>
    </div>

    <!-- CTA secundario -->
    <a href="#novedades" class="novedades-btn">Novedades</a>
  </div>
</header>

<!-- Mega Menú Desplegable -->
<div
  id="mobile-menu"
  class="mega-menu-overlay"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="mega-menu-container crystal-fx">
    <!-- Top Bar Interna -->
    <div class="menu-top-bar">
      <button class="close-menu" aria-label="Cerrar menú">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"

---
---
<header class="header-wrapper">
  <div class="header-block">
    <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <div class="hero-text-loop">
      <span class="loop-word active">LEARN</span>
      <span class="loop-word">EXPLORE</span>
      <span class="loop-word">ASPIRE</span>
      <span class="loop-word">DISCOVER</span>
    </div>

    <a href="#novedades" class="novedades-btn">Novedades</a>
  </div>
</header>

<!-- Menú desplegable -->
<div id="mobile-menu" class="mobile-menu crystal-fx" role="dialog" aria-modal="true" aria-hidden="true">
  <button class="close-menu" aria-label="Cerrar menú">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>
  <nav class="mobile-nav">
    <!-- Enlaces vacíos por ahora según instrucción -->
    <a href="#" class="nav-link">Home</a>
    <a href="#" class="nav-link">About</a>
    <a href="#" class="nav-link">Events</a>
    <a href="#" class="nav-link">Contact</a>
  </nav>
</div>

<script>
  // Script para manejar el menú
  const menuToggle = document.querySelector('.menu-toggle');
  const closeMenu = document.querySelector('.close-menu');
  const mobileMenu = document.getElementById('mobile-menu');

  const openMenu = () => {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.setAttribute('aria-hidden', 'false');
    menuToggle.setAttribute('aria-expanded', 'true');
    mobileMenu.classList.add('open');
    document.body.style.overflow = 'hidden';
  };

  const closeMenuFunc = () => {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.setAttribute('aria-hidden', 'true');
    menuToggle.setAttribute('aria-expanded', 'false');
    mobileMenu.classList.remove('open');
    document.body.style.overflow = '';
  };

  menuToggle?.addEventListener('click', openMenu);
  closeMenu?.addEventListener('click', closeMenuFunc);

  // Script para el hero text loop
  const words = document.querySelectorAll('.loop-word');
  let currentWord = 0;

  setInterval(() => {
    words[currentWord].classList.remove('active');
    words[currentWord].classList.add('exit');
    
    // Cleanup de la clase exit después de la animación
    const exitedWord = words[currentWord];
    setTimeout(() => {
      exitedWord.classList.remove('exit');
    }, 500); // 500ms debe ser igual a la duración de la transición CSS
    
    currentWord = (currentWord + 1) % words.length;
    words[currentWord].classList.add('active');
  }, 3000);
</script>

<style>
  .header-wrapper {
    display: flex;
    justify-content: center;
    padding: var(--space-4);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .header-block {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #F59E0B; /* Naranja central */
    padding: 8px 16px;
    border-radius: 4px;
    gap: var(--space-4);
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.2);
  }

  /* Animated Hero Text Loop */
  .hero-text-loop {
    position: relative;
    height: 32px;
    width: 110px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .loop-word {
    position: absolute;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: #ffffff; /* Contrast against orange */
    letter-spacing: 2px;
    opacity: 0;
    transform: translateY(20px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
  }

  .loop-word.active {
    opacity: 1;
    transform: translateY(0);
  }
  
  .loop-word.exit {
    opacity: 0;
    transform: translateY(-20px);
  }

  .novedades-btn {
    background-color: #111; /* Dark background */
    color: white;
    text-decoration: none;
    padding: 6px 16px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
  }

  .novedades-btn:hover {
    background-color: #000;
    border-color: #fff;
  }

  /* Hamburger Menu */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
    z-index: 100;
  }

  .menu-toggle:focus {
    outline: 2px solid white;
    outline-offset: 4px;
    border-radius: 4px;
  }

  .menu-toggle .bar {
    width: 24px;
    height: 3px;
    background-color: white;
    border-radius: 2px;
    transition: all 0.3s linear;
  }

  .menu-toggle:hover .bar {
    background-color: var(--bg-deep);
  }

  /* Mobile Menu Off-Canvas */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: -100%;
    width: 320px;
    max-width: 100%;
    height: 100vh;
    z-index: 1000;
    padding: var(--space-5) var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-radius: 0; /* Override crystal-fx for full height */
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    transition: right 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    visibility: hidden; /* Para a11y */
  }

  .mobile-menu.open {
    right: 0;
    visibility: visible;
  }

  .close-menu {
    position: absolute;
    top: var(--space-3);
    right: var(--space-4);
    background: none;
    border: none;
    color: var(--text-title);
    cursor: pointer;
    padding: 8px; /* a11y hit area */
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .close-menu:hover {
    color: var(--magenta);
    transform: rotate(90deg);
  }

  .close-menu:focus {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 24px;
    color: var(--text-body);
    font-weight: 500;
    transition: color 0.2s, transform 0.2s;
    text-decoration: none;
  }

  .nav-link:hover, .nav-link:focus {
    color: var(--cyan);
    transform: translateX(10px);
    outline: none;
  }

  /* Responsive fixes */
  @media (max-width: 768px) {
    .hero-text-loop {
      display: none; /* Ocultar loop de texto en mobile para no saturar header */
    }
  }
</style>

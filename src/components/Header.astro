---
// Header.astro
---

<!-- Header Wrapper -->
<header class="header-wrapper">
  <div class="header-block">
    <button
      class="menu-toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <div class="hero-text-loop">
      <span class="loop-word active">LEARN</span>
      <span class="loop-word">EXPLORE</span>
      <span class="loop-word">ASPIRE</span>
      <span class="loop-word">DISCOVER</span>
    </div>

    <!-- CTA secundario -->
    <a href="#novedades" class="novedades-btn">Novedades</a>
  </div>
</header>

<!-- Mega Menú Desplegable -->
<div
  id="mobile-menu"
  class="mega-menu-overlay"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="mega-menu-container crystal-fx">
    <!-- Top Bar Interna -->
    <div class="menu-top-bar">
      <button class="close-menu" aria-label="Cerrar menú">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="menu-logo">
        <span class="orange-l">L</span>EAD UPN
      </div>
    </div>

    <!-- Contenedor Principal (Grid de 2 Columnas) -->
    <div class="menu-grid">
      <!-- Columna Izquierda (Destacado) -->
      <div class="menu-col-left">
        <div class="featured-card">
          <div class="featured-img image-gradient"></div>
          <div class="featured-content">
            <span class="featured-badge">Descubre</span>
            <h2 class="featured-title">
              Tecnología & <br /><span class="highlight teal">Innovación</span>
            </h2>
            <p class="featured-desc">
              Impulsamos el desarrollo integral de los estudiantes con propósito.
            </p>
          </div>
        </div>

        <div class="left-links">
          <div class="link-group">
            <a href="#">Desarrollo Profesional</a>
            <a href="#">Impacto Comunitario</a>
            <a href="#">Desarrollo de Capítulo</a>
            <a href="#">Área de Marketing</a>
          </div>
        </div>
      </div>

      <!-- Columna Derecha (CTAs y Navegación) -->
      <div class="menu-col-right">
        <!-- Big CTA -->
        <a href="/unete" class="huge-cta">
          <div class="cta-content">
            <h3>Postula a LEAD</h3>
            <p>Convocatoria Abierta</p>
          </div>
          <div class="cta-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="19" x2="19" y2="5"></line>
              <polyline points="10 5 19 5 19 14"></polyline>
            </svg>
          </div>
        </a>

        <!-- Grid de Enlaces Internos -->
        <div class="right-links-grid">
          <div class="link-column">
            <h4 class="link-header">NOSOTROS</h4>
            <a href="#">Portafolio</a>
            <a href="#">Nuestro Equipo</a>
            <a href="#">Pilares</a>
          </div>
          <div class="link-column">
            <h4 class="link-header">EVENTOS</h4>
            <a href="#">LEAD Gala</a>
            <a href="#">Workshops</a>
            <a href="#">Bootcamps</a>
          </div>
          <div class="link-column">
            <h4 class="link-header">CONTACTO</h4>
            <a href="#" class="contact-highlight">Únete a WhatsApp</a>
            <a href="#">Instagram</a>
            <p class="contact-email">leadupntrujillo@gmail.com</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Script para manejar el menú
  const menuToggle = document.querySelector(".menu-toggle");
  const closeMenu = document.querySelector(".close-menu");
  const mobileMenu = document.getElementById("mobile-menu");

  const openMenu = () => {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.setAttribute("aria-hidden", "false");
    menuToggle.setAttribute("aria-expanded", "true");
    mobileMenu.classList.add("open");
    document.body.style.overflow = "hidden";
  };

  const closeMenuFunc = () => {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.setAttribute("aria-hidden", "true");
    menuToggle.setAttribute("aria-expanded", "false");
    mobileMenu.classList.remove("open");
    document.body.style.overflow = "";
  };

  menuToggle?.addEventListener("click", openMenu);
  closeMenu?.addEventListener("click", closeMenuFunc);

  // Script para el hero text loop
  const words = document.querySelectorAll(".loop-word");
  if (words.length > 0) {
    let currentWord = 0;
    setInterval(() => {
      words[currentWord].classList.remove("active");
      words[currentWord].classList.add("exit");

      const exitedWord = words[currentWord];
      setTimeout(() => {
        exitedWord.classList.remove("exit");
      }, 500);

      currentWord = (currentWord + 1) % words.length;
      words[currentWord].classList.add("active");
    }, 3000);
  }

  // Script para el header al hacer scroll
  const headerWrapper = document.querySelector(".header-wrapper");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      headerWrapper?.classList.add("scrolled");
    } else {
      headerWrapper?.classList.remove("scrolled");
    }
  });
</script>

<style>
  /* =========================================
     HEADER SLEEK PILL (Light Mode Homologated)
     ========================================= */
  .header-wrapper {
    display: flex;
    justify-content: center;
    padding: var(--space-4);
    position: sticky;
    top: 0;
    z-index: 50;
    pointer-events: none;
    transition: padding 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header-wrapper.scrolled {
    padding: var(--space-2) var(--space-4);
  }

  .header-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.85); /* Light glass */
    padding: 8px 16px 8px 20px;
    border-radius: 50px;
    gap: var(--space-5);
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: auto;
  }

  .header-wrapper.scrolled .header-block {
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }

  /* Animated Hero Text Loop */
  .hero-text-loop {
    position: relative;
    height: 32px;
    width: 120px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .loop-word {
    position: absolute;
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 800;
    color: var(--text-dark);
    letter-spacing: 1px;
    opacity: 0;
    transform: translateY(20px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
  }

  .loop-word.active {
    opacity: 1;
    transform: translateY(0);
  }

  .loop-word.exit {
    opacity: 0;
    transform: translateY(-20px);
    color: var(--lead-gold);
  }

  /* Solid Guinda CTA */
  .novedades-btn {
    background: var(--guinda);
    color: #ffffff;
    text-decoration: none;
    padding: 10px 24px;
    border-radius: 50px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(234, 88, 12, 0.3);
  }

  .novedades-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(125, 27, 54, 0.4); /* Guinda shadow */
  }

  /* Hamburger Menu */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .menu-toggle .bar {
    width: 24px;
    height: 2px;
    background-color: var(--text-dark);
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-toggle:hover .bar {
    background-color: var(--lead-gold);
  }

  /* =========================================
     MEGA MENU MODAL
     ========================================= */
  .mega-menu-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    background: rgba(15, 23, 42, 0.3); /* Slate dark overlay */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: all 0.4s ease;
  }

  .mega-menu-overlay.open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .mega-menu-container {
    width: 100%;
    max-width: 1100px;
    max-height: 90vh;
    overflow-y: auto;
    overflow-x: hidden;
    transform: scale(0.95) translateY(20px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mega-menu-overlay.open .mega-menu-container {
    transform: scale(1) translateY(0);
  }

  .menu-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .close-menu {
    background: var(--bg-page);
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-dark);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .close-menu:hover {
    background: var(--guinda);
    color: white;
    transform: rotate(90deg);
  }

  .menu-logo {
    font-size: 24px;
    font-weight: 800;
    color: var(--text-dark);
  }
  .menu-logo .orange-l {
    color: var(--lead-gold);
  }

  .menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .menu-col-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-right: 1px solid rgba(0, 0, 0, 0.05);
    padding-right: var(--space-5);
  }

  .featured-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: var(--bg-page);
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .featured-content {
    position: relative;
    z-index: 10;
    padding: var(--space-4);
    background: linear-gradient(to top, rgba(255,255,255,1), rgba(255,255,255,0));
  }

  .featured-badge {
    background: var(--stem-blue);
    color: white;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 8px;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
    display: inline-block;
  }

  .featured-title {
    font-size: 28px;
    color: var(--text-dark);
  }
  .highlight.teal { color: var(--stem-blue); }

  .featured-desc {
    font-size: 14px;
    color: var(--text-body);
  }

  .link-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .link-group a {
    font-size: 15px;
    color: var(--text-dark);
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .link-group a:hover { color: var(--lead-gold); }

  .menu-col-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .huge-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(135deg, var(--purple-dark), var(--magenta-pink));
    padding: var(--space-4);
    border-radius: 24px;
    text-decoration: none;
    color: white;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .huge-cta:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px rgba(177, 74, 146, 0.3); /* Magenta shadow */
  }

  .cta-content h3 { color: white; font-size: 28px; }
  .cta-arrow {
    background: white;
    color: var(--purple-dark);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .right-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .link-column { display: flex; flex-direction: column; gap: 12px; }
  .link-header { font-size: 12px; color: var(--text-body); letter-spacing: 2px; }
  .link-column a { color: var(--text-dark); font-weight: 500; }
  .link-column a:hover { color: var(--lead-gold); }
  .contact-highlight { color: var(--stem-blue) !important; font-weight: 700; }
  .contact-email { font-size: 14px; color: var(--text-body); }

  @media (max-width: 768px) {
    .header-wrapper { padding: var(--space-2); }
    .header-wrapper.scrolled { padding: var(--space-1) var(--space-2); }
    .header-block { gap: var(--space-3); padding: 6px 12px 6px 16px; }
    .hero-text-loop { width: 100px; }
    .loop-word { font-size: 16px; }
    .novedades-btn { padding: 8px 16px; font-size: 12px; }
    
    .menu-grid { grid-template-columns: 1fr; }
    .menu-col-left { border-right: none; padding-right: 0; border-bottom: 1px solid rgba(0,0,0,0.05); padding-bottom: var(--space-4); }
    .right-links-grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .huge-cta { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .cta-arrow { align-self: flex-end; }
  }
</style>

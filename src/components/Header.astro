          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="menu-logo">
        <span class="magenta-l">L</span>EAD UPN
      </div>
    </div>

    <!-- Contenedor Principal (Grid de 2 Columnas) -->
    <div class="menu-grid">
      <!-- Columna Izquierda (Destacado) -->
      <!-- [TODO] USER: Modifica los textos e imagen de esta sección con la info real de la organización -->
      <div class="menu-col-left">
        <div class="featured-card">
          <div class="featured-img image-gradient"></div>
          <div class="featured-content">
            <span class="featured-badge">Descubre</span>
            <h2 class="featured-title">
              Tecnología & <br /><span class="highlight cyan">Innovación</span>
            </h2>
            <!-- Rellena este texto con tu descripción -->
            <p class="featured-desc">
              Impulsamos el desarrollo integral de los estudiantes con
              propósito, marcando la pauta en tecnología y liderazgo.
            </p>
          </div>
        </div>

        <div class="left-links">
          <div class="link-group">
            <a href="#">Desarrollo Profesional</a>
            <a href="#">Impacto Comunitario</a>
            <a href="#">Desarrollo de Capítulo</a>
            <a href="#">Área de Marketing</a>
          </div>
        </div>
      </div>

      <!-- Columna Derecha (CTAs y Navegación) -->
      <div class="menu-col-right">
        <!-- Big CTA (Emula el cajón verde brillante del diseño) -->
        <a href="/unete" class="huge-cta">
          <div class="cta-content">
            <h3>Postula a LEAD</h3>
            <p>Convocatoria 2026 Abierta</p>
          </div>
          <div class="cta-arrow">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="19" x2="19" y2="5"></line>
              <polyline points="10 5 19 5 19 14"></polyline>
            </svg>
          </div>
        </a>

        <!-- Grid de Enlaces Internos -->
        <!-- [TODO] USER: Actualiza los href y nombres de las páginas reales -->
        <div class="right-links-grid">
          <div class="link-column">
            <h4 class="link-header">NOSOTROS</h4>
            <a href="#">Portafolio</a>
            <a href="#">Nuestro Equipo</a>
            <a href="#">Pilares</a>
            <a href="#">Comunidad</a>
          </div>
          <div class="link-column">
            <h4 class="link-header">EVENTOS</h4>
            <a href="#">LEAD Gala</a>
            <a href="#">Workshops</a>
            <a href="#">Conferencias</a>
            <a href="#">Bootcamps</a>
          </div>
          <div class="link-column">
            <h4 class="link-header">CONTACTO</h4>
            <a href="#" class="contact-highlight">Únete a WhatsApp</a>
            <a href="#">Instagram</a>
            <a href="#">LinkedIn</a>
            <br />
            <p class="contact-email">leadupntrujillo@gmail.com</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Script para manejar el menú
  const menuToggle = document.querySelector(".menu-toggle");
  const closeMenu = document.querySelector(".close-menu");
  const mobileMenu = document.getElementById("mobile-menu");

  const openMenu = () => {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.setAttribute("aria-hidden", "false");
    menuToggle.setAttribute("aria-expanded", "true");
    mobileMenu.classList.add("open");
    document.body.style.overflow = "hidden";
  };

  const closeMenuFunc = () => {
    if (!mobileMenu || !menuToggle) return;
    mobileMenu.setAttribute("aria-hidden", "true");
    menuToggle.setAttribute("aria-expanded", "false");
    mobileMenu.classList.remove("open");
    document.body.style.overflow = "";
  };

  menuToggle?.addEventListener("click", openMenu);
  closeMenu?.addEventListener("click", closeMenuFunc);

  // Script para el hero text loop
  const words = document.querySelectorAll(".loop-word");
  if (words.length > 0) {
    let currentWord = 0;
    setInterval(() => {
      words[currentWord].classList.remove("active");
      words[currentWord].classList.add("exit");

      const exitedWord = words[currentWord];
      setTimeout(() => {
        exitedWord.classList.remove("exit");
      }, 500);

      currentWord = (currentWord + 1) % words.length;
      words[currentWord].classList.add("active");
    }, 3000);
  }

  // Script para el header al hacer scroll
  const headerWrapper = document.querySelector(".header-wrapper");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      headerWrapper?.classList.add("scrolled");
    } else {
      headerWrapper?.classList.remove("scrolled");
    }
  });
</script>

<style>
  /* =========================================
     HEADER SLEEK PILL (Glassmorphism Tech)
     ========================================= */
  .header-wrapper {
    display: flex;
    justify-content: center;
    padding: var(--space-4);
    position: sticky;
    top: 0;
    z-index: 50;
    pointer-events: none; /* Permite click abajo si el pill es pequeño */
    transition: padding 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header-wrapper.scrolled {
    padding: var(--space-2) var(--space-4);
  }

  .header-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(10, 15, 44, 0.65); /* bg-deep dark glass */
    padding: 8px 16px 8px 20px;
    border-radius: 50px; /* Pill shape */
    gap: var(--space-5);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: auto; /* Restaura el click dentro del pill */
  }

  .header-wrapper.scrolled .header-block {
    background: rgba(10, 15, 44, 0.92);
    box-shadow:
      0 15px 40px rgba(0, 0, 0, 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
  }

  .header-block:hover {
    box-shadow:
      0 10px 40px rgba(42, 246, 255, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border-color: rgba(42, 246, 255, 0.3);
    transform: translateY(-2px);
  }

  /* Animated Hero Text Loop */
  .hero-text-loop {
    position: relative;
    height: 32px;
    width: 120px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .loop-word {
    position: absolute;
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--text-title);
    letter-spacing: 2px;
    opacity: 0;
    transform: translateY(20px);
    transition:
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.5s ease;
  }

  .loop-word.active {
    opacity: 1;
    transform: translateY(0);
  }

  .loop-word.exit {
    opacity: 0;
    transform: translateY(-20px);
    color: var(--cyan); /* Sale brillando */
  }

  .novedades-btn {
    background: linear-gradient(
      135deg,
      rgba(230, 42, 107, 0.1),
      rgba(42, 246, 255, 0.1)
    );
    color: var(--text-title);
    text-decoration: none;
    padding: 8px 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 30px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
  }

  .novedades-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--cyan);
    color: var(--cyan);
    box-shadow: 0 0 20px rgba(42, 246, 255, 0.2);
  }

  /* Hamburger Menu (Sleek) */
  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .menu-toggle .bar {
    width: 24px;
    height: 2px;
    background-color: var(--text-title);
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-toggle:hover .bar {
    background-color: var(--cyan);
  }

  .menu-toggle:hover .bar:nth-child(2) {
    transform: translateX(4px);
  }
  .menu-toggle:hover .bar:nth-child(1) {
    transform: translateX(-2px);
  }
  .menu-toggle:hover .bar:nth-child(3) {
    transform: translateX(-2px);
  }

  /* =========================================
     MEGA MENU MODAL (Full Screen Overlay)
     ========================================= */
  .mega-menu-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    background: rgba(10, 15, 44, 0.4); /* Oscurece el fondo */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);

    /* Animación de entrada */
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: all 0.4s ease;
  }

  .mega-menu-overlay.open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .mega-menu-container {
    width: 100%;
    max-width: 1100px;
    height: auto;
    max-height: 90vh;
    background: var(--bg-core);
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;

    /* Efecto Modal animado */
    transform: scale(0.95) translateY(20px);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mega-menu-overlay.open .mega-menu-container {
    transform: scale(1) translateY(0);
  }

  /* Logotipo y Título en el Modal */
  .menu-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .close-menu {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-title);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .close-menu:hover {
    background: var(--magenta);
    border-color: var(--magenta);
    transform: rotate(90deg);
  }

  .menu-logo {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-title);
  }
  .menu-logo .magenta-l {
    color: var(--magenta);
    text-shadow: 0 0 10px rgba(230, 42, 107, 0.6);
  }

  /* Grid Layout del Menu */
  .menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  /* ====== COLUMNA IZQUIERDA ====== */
  .menu-col-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    padding-right: var(--space-5);
  }

  .featured-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
    min-height: 240px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .featured-img {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(10, 15, 44, 0.1) 0%,
        rgba(10, 15, 44, 0.9) 100%
      ),
      url("/portada-lead.png") center/cover;
    z-index: 0;
    transition: transform 0.5s ease;
  }

  .featured-card:hover .featured-img {
    transform: scale(1.05);
  }

  .featured-content {
    position: relative;
    z-index: 10;
    padding: var(--space-4);
  }

  .featured-badge {
    background: var(--magenta);
    color: white;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--space-2);
    display: inline-block;
  }

  .featured-title {
    font-size: 28px;
    line-height: 1.1;
    margin-bottom: var(--space-2);
  }
  .featured-title .highlight.cyan {
    color: var(--cyan);
  }

  .featured-desc {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    max-width: 90%;
  }

  .left-links {
    padding-top: var(--space-2);
  }

  .link-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .link-group a {
    font-size: 15px;
    color: var(--text-body);
    font-weight: 500;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .link-group a:hover {
    color: white;
    transform: translateX(4px);
  }

  /* ====== COLUMNA DERECHA ====== */
  .menu-col-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .huge-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--cyan); /* Cyan brillante para impactar */
    padding: var(--space-4);
    border-radius: 16px;
    text-decoration: none;
    color: var(--bg-deep); /* Texto oscuro para contraste */
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .huge-cta:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 30px rgba(42, 246, 255, 0.4);
  }

  .cta-content h3 {
    font-size: 28px;
    color: var(--bg-deep);
    margin-bottom: 4px;
  }

  .cta-content p {
    font-size: 15px;
    font-weight: 600;
    opacity: 0.8;
  }

  .cta-arrow {
    background: var(--bg-deep);
    color: var(--cyan);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .huge-cta:hover .cta-arrow {
    transform: rotate(45deg);
  }

  .right-links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .link-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .link-header {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 2px;
    margin-bottom: 8px;
  }

  .link-column a {
    color: var(--text-title);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }

  .link-column a:hover {
    color: var(--cyan);
  }

  .contact-highlight {
    color: var(--gold) !important;
  }

  .contact-email {
    font-size: 14px;
    color: var(--text-body);
    font-family: monospace;
  }

  /* ====== RESPONSIVE ====== */
  @media (max-width: 900px) {
    .menu-grid {
      grid-template-columns: 1fr;
    }
    .menu-col-left {
      border-right: none;
      padding-right: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: var(--space-4);
    }
    .mega-menu-container {
      max-height: 95vh;
    }
  }

  @media (max-width: 600px) {
    .right-links-grid {
      grid-template-columns: 1fr; /* Stack vertical */
      gap: var(--space-4);
    }
    .huge-cta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .cta-arrow {
      align-self: flex-end;
    }
  }
</style>

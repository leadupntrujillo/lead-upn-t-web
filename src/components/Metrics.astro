---

<section class="metrics" aria-label="Nuestras Métricas">
  <div class="metrics-grid">
    
    <!-- Tarjeta 1: Instagram -->
    <div class="metric-card crystal-fx instagram-card">
      <div class="glow-layer"></div>
      <h3 class="metric-title">INSTAGRAM COMMUNITY</h3>
      <p class="metric-number instagram">+5.2k</p>
    </div>

    <!-- Tarjeta 2: WhatsApp -->
    <div class="metric-card crystal-fx whatsapp-card">
      <div class="glow-layer"></div>
      <h3 class="metric-title">WHATSAPP MEMBERS</h3>
      <p class="metric-number whatsapp">+1.1k</p>
    </div>

    <!-- Tarjeta 3: LinkedIn -->
    <div class="metric-card crystal-fx linkedin-card">
      <div class="glow-layer"></div>
      <h3 class="metric-title">LINKEDIN FOLLOWERS</h3>
      <p class="metric-number linkedin">+800</p>
    </div>

  </div>
</section>

<script>
  // Intersection Observer setup for an entrance animation (Micro-interacción UX pro)
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('fade-in');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.metric-card').forEach(card => {
    observer.observe(card);
  });
</script>

<style>
  .metrics {
    padding: var(--space-6) var(--space-3);
    max-width: 1200px; /* Responsive consistency */
    margin: 0 auto;
    width: 100%;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
    /* Avoid horizontal scroll */
  }

  .metric-card {
    padding: var(--space-4);
    text-align: center;
    position: relative;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    border-radius: 20px; /* Mas suave */
    opacity: 0;
    transform: translateY(30px);
    overflow: hidden;
  }

  .metric-card.fade-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* Micro interactividad: hover scale 1.02, como sugiere ui-ux-pro-max-skill */
  .metric-card:hover {
    transform: translateY(-5px) scale(1.02);
  }

  /* Neon Glow Background Logic */
  .glow-layer {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 0;
  }

  .metric-card:hover .glow-layer {
    opacity: 0.1; /* Resplandor sutil para no deslumbrar */
  }

  .instagram-card .glow-layer {
    background: radial-gradient(circle, var(--magenta) 0%, transparent 50%);
  }

  .whatsapp-card .glow-layer {
    background: radial-gradient(circle, var(--cyan) 0%, transparent 50%);
  }

  .linkedin-card .glow-layer {
    background: radial-gradient(circle, var(--gold) 0%, transparent 50%);
  }

  /* Content Overlay */
  .metric-title {
    font-size: 14px;
    letter-spacing: 2px;
    margin-bottom: var(--space-2);
    font-weight: 500;
    position: relative;
    z-index: 10;
    color: var(--text-title);
  }

  .metric-number {
    font-family: var(--font-heading);
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    position: relative;
    z-index: 10;
    text-shadow: 0 0 20px rgba(0,0,0,0.5); /* Mejor legibilidad (a11y) */
  }

  /* Specific Resplandores Neon Textuales */
  .instagram {
    color: var(--magenta);
    text-shadow: 0 0 20px rgba(230, 42, 107, 0.4);
  }

  .whatsapp {
    color: var(--cyan);
    text-shadow: 0 0 20px rgba(42, 246, 255, 0.4);
  }

  .linkedin {
    color: var(--gold);
    text-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
  }

  /* Accessibility Focus States */
  .metric-card:focus-within, .metric-card:focus {
    outline: 2px solid var(--text-title);
    outline-offset: 4px;
  }
</style>

---
import { getSitio } from '../lib/queries';

/** Franja final "Súmate a la familia LEAD": la acción principal del sitio (Únete). */
interface Props {
	/** Antetítulo, p. ej. "04 · Discover" en la portada. */
	kicker?: string;
}

const { kicker } = Astro.props;
const sitio = await getSitio();
const externo = /^https?:/.test(sitio.unete.url);
const esInstagram = sitio.unete.url.includes('instagram.com');
---

<section id="unete" class="unete" aria-labelledby="t-unete">
	<p class="unete__fondo titulo" aria-hidden="true">&gt;&gt;&gt;</p>
	<div class="contenedor unete__fila">
		<div class="unete__texto">
			{kicker && <p class="kicker">{kicker}</p>}
			<h2 id="t-unete" class="titulo">Súmate a la familia <span class="caja">LEAD</span></h2>
			<p>{sitio.unete.texto}</p>
		</div>
		<a
			class="btn btn--claro unete__boton"
			href={sitio.unete.url}
			data-cta="unete"
			{...externo ? { rel: 'noopener noreferrer', target: '_blank' } : {}}
		>
			{esInstagram ? 'Síguenos en Instagram' : 'Únete a LEAD'}
		</a>
	</div>
</section>

<style>
	.unete {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background: var(--degradado-boton);
		color: var(--blanco);
		padding-block: clamp(3.5rem, 8vw, 6rem);
	}
	.unete__fondo {
		position: absolute;
		left: -0.75rem;
		bottom: -2.5rem;
		z-index: -1;
		font-size: clamp(10rem, 22vw, 18.75rem);
		line-height: 0.8;
		letter-spacing: -0.06em;
		color: rgb(255 255 255 / 0.08);
		white-space: nowrap;
		pointer-events: none;
	}
	.unete__fila {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 2.5rem;
	}
	.unete__texto {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
		max-width: 45rem;
	}
	.unete h2 {
		font-size: clamp(3.25rem, 7vw, 6.5rem);
		line-height: 0.95;
	}
	.unete__texto > p:last-child {
		max-width: 32.5rem;
		font-size: 1.1875rem;
	}
	.unete__boton {
		min-height: 3.5rem;
		padding: 1rem 2rem;
		font-size: 1.0625rem;
	}
	@media (max-width: 48rem) {
		.unete__fila {
			gap: 1.25rem;
		}
		.unete__texto {
			gap: 1.1rem;
		}
		.unete__texto > p:last-child {
			font-size: 1rem;
		}
		.unete__boton {
			width: 100%;
			min-height: 3rem;
			padding: 0.8rem 1.5rem;
			font-size: 0.95rem;
		}
		.unete__fondo {
			display: none;
		}
	}
</style>

---
import type { CollectionEntry } from 'astro:content';
import { colorPilar } from '../lib/pilares';

/** Pilares como lista numerada 01–07: número, punto de color, nombre, descripción y enlace a su página. */
interface Props {
	pilares: CollectionEntry<'pilares'>[];
}

const { pilares } = Astro.props;
const numero = (i: number) => String(i + 1).padStart(2, '0');
---

<ol class="pilares">
	{
		pilares.map((p, i) => (
			<li>
				<a class="pilar" href={`/pilares/${p.data.slug}`} style={`--punto:${colorPilar(p.data.color)}`}>
					<span class="pilar__numero titulo" aria-hidden="true">
						{numero(i)}
					</span>
					<span class="pilar__texto">
						<span class="pilar__nombre">
							<span class="pilar__punto" aria-hidden="true" />
							{p.data.nombre}
						</span>
						{p.data.descripcion && <span class="pilar__desc">{p.data.descripcion}</span>}
					</span>
					<span class="pilar__ir flechas" aria-hidden="true" />
				</a>
			</li>
		))
	}
</ol>

<style>
	.pilares {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 2px solid var(--marino);
	}
	.pilar {
		display: grid;
		grid-template-columns: 4.5rem minmax(0, 1fr) auto;
		gap: 1.25rem;
		align-items: center;
		padding: 1.375rem 0;
		border-bottom: 1px solid var(--linea);
		text-decoration: none;
	}
	.pilar__numero {
		font-size: 2.5rem;
		line-height: 1;
		color: var(--morado);
	}
	.pilar__texto {
		display: grid;
		gap: 0.125rem;
	}
	.pilar__nombre {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1.3;
	}
	.pilar__punto {
		flex: none;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--punto);
	}
	.pilar__desc {
		font-size: 0.875rem;
		color: var(--tinta-suave);
	}
	.pilar__ir {
		color: var(--magenta);
		transition: transform 0.2s;
	}
	.pilar:hover .pilar__ir {
		transform: translateX(6px);
	}
	.pilar:hover .pilar__nombre {
		color: var(--magenta);
	}

	@media (max-width: 48rem) {
		.pilar {
			grid-template-columns: 2.25rem minmax(0, 1fr);
			gap: 0.875rem;
			padding: 1rem 0;
		}
		.pilar__numero {
			font-size: 1.75rem;
		}
		.pilar__nombre {
			font-size: 1rem;
		}
		.pilar__desc,
		.pilar__ir {
			display: none;
		}
	}
</style>

---
import Logo from './Logo.astro';

const anio = new Date().getFullYear();
---

<footer class="pie">
	<div class="contenedor pie__grid">
		<div class="pie__marca">
			<Logo />
			<p class="pie__lema">Learn, Explore, Aspire, Discover.</p>
			<p class="pie__texto">
				Organización estudiantil de liderazgo con propósito de la Universidad Privada del Norte, sede Trujillo.
			</p>
		</div>

		<nav class="pie__nav" aria-label="Secciones">
			<a href="/novedades">Novedades</a>
			<a href="/#pilares">Pilares</a>
			<a href="/#unete">Únete</a>
		</nav>

		<div class="pie__redes">
			<a
				class="pie__red"
				href="https://www.instagram.com/leadupn_trujillo/"
				rel="noopener noreferrer"
				target="_blank"
				aria-label="Instagram de LEAD UPN Trujillo"
			>
				<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="3" width="18" height="18" rx="5.5"></rect>
					<circle cx="12" cy="12" r="4.2"></circle>
					<circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"></circle>
				</svg>
				<span>@leadupn_trujillo</span>
			</a>
		</div>
	</div>
	<div class="contenedor pie__legal">
		<p>© {anio} LEAD UPN Trujillo.</p>
	</div>
</footer>

<style>
	.pie {
		background: var(--noche);
		color: rgb(255 255 255 / 0.85);
		padding-block: 3rem 1.5rem;
		margin-top: auto;
	}
	.pie__grid {
		display: grid;
		gap: 2rem;
		grid-template-columns: 1fr;
	}
	@media (min-width: 48rem) {
		.pie__grid {
			grid-template-columns: 1.6fr 1fr 1fr;
		}
	}
	.pie__marca {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}
	.pie__lema {
		font-family: var(--f-display);
		font-size: 1.5rem;
		text-transform: uppercase;
		color: var(--blanco);
		line-height: 1.1;
	}
	.pie__texto {
		max-width: 32ch;
		font-size: 0.9rem;
		line-height: 1.6;
	}
	.pie__nav {
		display: grid;
		gap: 0.5rem;
		align-content: start;
	}
	.pie__nav a {
		text-decoration: none;
		font-weight: 500;
	}
	.pie__nav a:hover,
	.pie__red:hover {
		color: var(--magenta-claro);
	}
	.pie__red {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		font-weight: 500;
	}
	.pie__legal {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(255 255 255 / 0.12);
		font-size: 0.8rem;
		opacity: 0.8;
	}
</style>

---
import type { Sitio } from '../lib/queries';

interface Props {
	sitio: Sitio;
}

const { sitio } = Astro.props;
const anio = new Date().getFullYear();

// Íconos de trazo simple (24×24). Solo se muestran las redes que tienen enlace en Notion.
const ICONOS: Record<string, string> = {
	instagram:
		'<rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/>',
	linkedin:
		'<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6c0-1.7 1-2.9 2.5-2.9S17 11.7 17 13.4V17M12 10.5V17"/>',
	tiktok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.3 2.6 2 4.4 5 4.7"/>',
	facebook: '<path d="M14.5 21v-7.5h2.6l.4-3h-3V8.7c0-.9.3-1.5 1.6-1.5h1.5V4.5c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.2H9v3h2.5V21"/>',
	whatsapp: '<path d="M4 20l1.2-3.9A8 8 0 1 1 8 19.1z"/>',
	correo: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
};
const NOMBRES: Record<string, string> = {
	instagram: 'Instagram',
	linkedin: 'LinkedIn',
	tiktok: 'TikTok',
	facebook: 'Facebook',
	whatsapp: 'WhatsApp',
};
const redes = Object.entries(sitio.redes).filter((r): r is [string, string] => Boolean(r[1]));
---

<footer class="pie">
	<div class="contenedor pie__grid">
		<div class="pie__marca">
			<a class="pie__simbolo" href="/" aria-label="LEAD UPN Trujillo, ir al inicio"><span aria-hidden="true"></span></a>
			<p class="pie__lema titulo">Learn, Explore,<br />Aspire, Discover.</p>
			<p class="pie__texto">
				Organización estudiantil de liderazgo con propósito de la Universidad Privada del Norte, sede Trujillo. Parte de
				LEAD Americas.
			</p>
		</div>

		<nav class="pie__columna" aria-labelledby="pie-explora">
			<p id="pie-explora" class="pie__rotulo">Explora</p>
			<a href="/nosotros">Nosotros</a>
			<a href="/equipo">Equipo</a>
			<a href="/novedades">Novedades</a>
			<a href="/#pilares">Pilares</a>
			<a href="/contacto">Contacto</a>
			<a href="/privacidad">Privacidad</a>
		</nav>

		<div class="pie__columna">
			<p id="pie-redes" class="pie__rotulo">Síguenos</p>
			<ul aria-labelledby="pie-redes">
				{
					redes.map(([red, url]) => (
						<li>
							<a class="pie__red" href={url} rel="noopener noreferrer" target="_blank" data-cta={`red-${red}`}>
								<svg class="pie__ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONOS[red]} />
								{NOMBRES[red]}
							</a>
						</li>
					))
				}
				{
					sitio.correo && (
						<li>
							<a class="pie__red" href={`mailto:${sitio.correo}`}>
								<svg class="pie__ico" viewBox="0 0 24 24" aria-hidden="true" set:html={ICONOS.correo} />
								{sitio.correo}
							</a>
						</li>
					)
				}
			</ul>
		</div>
	</div>
	<div class="contenedor pie__legal">
		<p>© {anio} LEAD UPN Trujillo</p>
		<p><a href="/rss.xml">RSS</a> · leadupntrujillo.com</p>
	</div>
</footer>

<style>
	.pie {
		background: var(--marino);
		color: var(--blanco);
		padding-block: 4.5rem 2rem;
		margin-top: auto;
		font-size: 0.9375rem;
	}
	.pie a {
		color: var(--blanco);
		text-decoration: none;
	}
	.pie a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.pie__grid {
		display: flex;
		flex-wrap: wrap;
		gap: 3rem;
	}
	.pie__marca {
		flex: 2 1 26rem;
		display: grid;
		gap: 1rem;
		align-content: start;
		justify-items: start;
	}
	.pie__simbolo span {
		display: block;
		width: 6rem;
		aspect-ratio: 720 / 430;
		background: var(--degradado-vertical);
		-webkit-mask: url('/brand/lead-mark.svg') center / contain no-repeat;
		mask: url('/brand/lead-mark.svg') center / contain no-repeat;
	}
	.pie__lema {
		font-size: clamp(2.25rem, 4vw, 2.75rem);
		line-height: 0.95;
	}
	.pie__texto {
		max-width: 26.25rem;
		color: var(--morado-claro);
	}
	.pie__columna {
		flex: 1 1 11.25rem;
		display: grid;
		gap: 0.625rem;
		align-content: start;
	}
	.pie__columna ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.625rem;
	}
	.pie__rotulo {
		margin-bottom: 0.375rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--morado-claro);
	}
	.pie__red {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
	}
	.pie__ico {
		width: 1.125rem;
		height: 1.125rem;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.pie__legal {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 3.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(255 255 255 / 0.12);
		font-size: 0.8125rem;
		color: var(--morado-claro);
	}
	.pie__legal a {
		color: inherit;
	}
	@media (max-width: 48rem) {
		.pie__grid {
			gap: 2.5rem;
		}
		.pie__marca {
			flex-basis: 100%;
		}
		.pie__columna {
			flex-basis: 100%;
		}
	}
</style>

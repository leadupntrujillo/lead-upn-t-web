---
import type { Sitio } from '../lib/queries';
import Logo from './Logo.astro';

interface Props {
	sitio: Sitio;
}

const { sitio } = Astro.props;
const anio = new Date().getFullYear();

// Íconos de trazo simple (24×24). Solo se muestran las redes que tienen enlace en Notion.
const ICONOS: Record<string, string> = {
	instagram:
		'<rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor"/>',
	linkedin:
		'<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17M8 7.5v.01M12 17v-3.6c0-1.7 1-2.9 2.5-2.9S17 11.7 17 13.4V17M12 10.5V17"/>',
	tiktok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.3 2.6 2 4.4 5 4.7"/>',
	facebook: '<path d="M14.5 21v-7.5h2.6l.4-3h-3V8.7c0-.9.3-1.5 1.6-1.5h1.5V4.5c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.2H9v3h2.5V21"/>',
	whatsapp:
		'<path d="M4 20l1.2-3.9A8 8 0 1 1 8 19.1z"/><path d="M9.2 8.6c.2-.4.5-.4.8-.4h.5c.2 0 .4.1.5.4l.6 1.5c.1.2 0 .5-.1.6l-.5.6c.6 1.2 1.6 2.1 2.8 2.7l.6-.6c.2-.2.4-.2.6-.1l1.5.7c.2.1.3.3.3.5v.5c0 .4-.2.8-.6 1-1 .5-2.5.3-4.3-1.1-1.6-1.2-2.8-2.9-3.1-4.2-.2-.8 0-1.6.4-2.1z" fill="currentColor" stroke="none"/>',
};
const NOMBRES: Record<string, string> = {
	instagram: 'Instagram',
	linkedin: 'LinkedIn',
	tiktok: 'TikTok',
	facebook: 'Facebook',
	whatsapp: 'WhatsApp',
};
const redes = Object.entries(sitio.redes).filter((r): r is [string, string] => Boolean(r[1]));
---

<footer class="pie">
	<div class="contenedor pie__grid">
		<div class="pie__marca">
			<Logo />
			<p class="pie__lema">Learn, Explore, Aspire, Discover.</p>
			<p class="pie__texto">
				Organización estudiantil de liderazgo con propósito de la Universidad Privada del Norte, sede Trujillo.
			</p>
		</div>

		<nav class="pie__nav" aria-label="Secciones">
			<a href="/nosotros">Nosotros</a>
			<a href="/equipo">Equipo</a>
			<a href="/novedades">Novedades</a>
			<a href="/#pilares">Pilares</a>
			<a href="/contacto">Contacto</a>
			<a href="/privacidad">Privacidad</a>
		</nav>

		<div class="pie__redes">
			<ul aria-label="Redes sociales">
				{
					redes.map(([red, url]) => (
						<li>
							<a class="pie__red" href={url} rel="noopener noreferrer" target="_blank" data-cta={`red-${red}`}>
								<svg
									viewBox="0 0 24 24"
									width="22"
									height="22"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									set:html={ICONOS[red]}
								/>
								<span>{NOMBRES[red]}</span>
							</a>
						</li>
					))
				}
			</ul>
			{sitio.correo && <a class="pie__correo" href={`mailto:${sitio.correo}`}>{sitio.correo}</a>}
		</div>
	</div>
	<div class="contenedor pie__legal">
		<p>© {anio} LEAD UPN Trujillo.</p>
		<a href="/rss.xml">RSS</a>
	</div>
</footer>

<style>
	.pie {
		background: var(--noche);
		color: rgb(255 255 255 / 0.85);
		padding-block: 3rem 1.5rem;
		margin-top: auto;
	}
	.pie__grid {
		display: grid;
		gap: 2rem;
		grid-template-columns: 1fr;
	}
	@media (min-width: 48rem) {
		.pie__grid {
			grid-template-columns: 1.6fr 1fr 1fr;
		}
	}
	.pie__marca {
		display: grid;
		gap: 1rem;
		justify-items: start;
	}
	.pie__lema {
		font-family: var(--f-display);
		font-size: 1.5rem;
		text-transform: uppercase;
		color: var(--blanco);
		line-height: 1.1;
	}
	.pie__texto {
		max-width: 32ch;
		font-size: 0.9rem;
		line-height: 1.6;
	}
	.pie__nav {
		display: grid;
		gap: 0.5rem;
		align-content: start;
	}
	.pie__nav a {
		text-decoration: none;
		font-weight: 400;
	}
	.pie__nav a:hover,
	.pie__red:hover {
		color: var(--magenta-claro);
	}
	.pie__redes ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}
	.pie__correo {
		display: inline-block;
		margin-top: 1rem;
		font-size: 0.9rem;
	}
	.pie__red {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		font-weight: 400;
	}
	.pie__legal {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(255 255 255 / 0.12);
		font-size: 0.8rem;
		opacity: 0.8;
	}
</style>

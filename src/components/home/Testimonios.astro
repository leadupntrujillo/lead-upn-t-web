---
import type { CollectionEntry } from 'astro:content';

/**
 * Carrusel de testimonios (03 · Aspire): un testimonio a la vez, sin avance automático.
 * El deslizamiento es nativo (scroll-snap), así que funciona con el dedo y sin JavaScript;
 * el script solo maneja las flechas y el contador.
 *  - "Frase destacada" → la cita grande.  - "Testimonio" → el contexto, debajo y recortado.
 *  - Sin frase, el testimonio pasa a ser la cita (en tamaño menor).
 */
interface Props {
	testimonios: CollectionEntry<'testimonios'>[];
}

const { testimonios } = Astro.props;
const total = testimonios.length;
const dos = (n: number) => String(n).padStart(2, '0');
const quienEs = (t: (typeof testimonios)[number]) => [t.data.carrera, t.data.rol].filter(Boolean).join(' · ');
---

<div class="carrusel" role="region" aria-roledescription="carrusel" aria-label="Testimonios de miembros" data-carrusel>
	<ul class="carrusel__pista" id="testimonios-pista" tabindex="0" aria-label="Testimonios (desliza para ver más)" data-pista>
		{
			testimonios.map((t, i) => {
				const d = t.data;
				const cita = d.frase || d.testimonio;
				const contexto = d.frase && d.testimonio !== d.frase ? d.testimonio : null;
				return (
					<li class="slide" role="group" aria-roledescription="testimonio" aria-label={`${i + 1} de ${total}`}>
						<figure class="slide__figura">
							{d.foto ? (
								<img
									class="polaroid slide__foto"
									src={d.foto.src}
									srcset={d.foto.srcset || undefined}
									sizes={d.foto.srcset ? '(max-width: 48rem) 9rem, 14rem' : undefined}
									width={d.foto.width ?? undefined}
									height={d.foto.height ?? undefined}
									alt={d.nombre}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<span class="polaroid slide__foto slide__foto--inicial titulo" aria-hidden="true">
									{d.nombre.charAt(0)}
								</span>
							)}
							<div class="slide__texto">
								<span class="slide__comilla titulo" aria-hidden="true">
									“
								</span>
								<blockquote class:list={['slide__cita', { 'slide__cita--larga': !d.frase }]}>{cita}</blockquote>
								{contexto && <p class="slide__contexto">{contexto}</p>}
								{d.habilidades.length > 0 && (
									<ul class="slide__habilidades" aria-label="Habilidades">
										{d.habilidades.slice(0, 3).map((h) => (
											<li class="pill pill--oscuro">{h}</li>
										))}
									</ul>
								)}
								<figcaption class="slide__autor">
									<strong>{d.nombre}</strong>
									{quienEs(t) && <span>{quienEs(t)}</span>}
								</figcaption>
							</div>
						</figure>
					</li>
				);
			})
		}
	</ul>

	{
		total > 1 && (
			<div class="carrusel__controles" data-controles>
				<p class="carrusel__contador" aria-live="polite" data-contador>
					<span class="sr-only">Testimonio </span>
					<span data-actual>01</span> / {dos(total)}
				</p>
				<button class="carrusel__boton" type="button" aria-controls="testimonios-pista" aria-label="Testimonio anterior" data-anterior>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
				</button>
				<button class="carrusel__boton" type="button" aria-controls="testimonios-pista" aria-label="Testimonio siguiente" data-siguiente>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
				</button>
			</div>
		)
	}
</div>

<script>
	// Flechas y contador. El deslizamiento en sí lo hace el navegador (scroll-snap).
	const reducir = window.matchMedia('(prefers-reduced-motion: reduce)');

	for (const raiz of document.querySelectorAll<HTMLElement>('[data-carrusel]')) {
		const pista = raiz.querySelector<HTMLElement>('[data-pista]');
		const anterior = raiz.querySelector<HTMLButtonElement>('[data-anterior]');
		const siguiente = raiz.querySelector<HTMLButtonElement>('[data-siguiente]');
		const actual = raiz.querySelector<HTMLElement>('[data-actual]');
		if (!pista || !anterior || !siguiente || !actual) continue;

		const total = pista.children.length;
		const indice = () => Math.round(pista.scrollLeft / Math.max(pista.clientWidth, 1));

		const pintar = () => {
			const i = Math.min(Math.max(indice(), 0), total - 1);
			actual.textContent = String(i + 1).padStart(2, '0');
			anterior.disabled = i === 0;
			siguiente.disabled = i === total - 1;
		};

		const ir = (paso: number) => {
			const destino = Math.min(Math.max(indice() + paso, 0), total - 1);
			pista.scrollTo({ left: destino * pista.clientWidth, behavior: reducir.matches ? 'auto' : 'smooth' });
		};

		anterior.addEventListener('click', () => ir(-1));
		siguiente.addEventListener('click', () => ir(1));

		let pendiente = 0;
		pista.addEventListener(
			'scroll',
			() => {
				if (pendiente) return;
				pendiente = requestAnimationFrame(() => {
					pendiente = 0;
					pintar();
				});
			},
			{ passive: true },
		);

		raiz.dataset.listo = '';
		pintar();
	}
</script>

<style>
	.carrusel {
		position: relative;
		border-radius: 1.75rem;
		background: rgb(255 255 255 / 0.05);
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
		overflow: hidden;
	}

	/* Pista: una fila de testimonios que encaja de a uno (también con el dedo en iPhone y Android) */
	.carrusel__pista {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 100%;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}
	.carrusel__pista::-webkit-scrollbar {
		display: none;
	}
	/* Sin JavaScript no hay flechas: se deja ver la barra para que se note que hay más */
	.carrusel:not([data-listo]) .carrusel__pista {
		scrollbar-width: thin;
	}
	.carrusel__pista:focus-visible {
		outline: 3px solid var(--magenta-claro);
		outline-offset: -3px;
		border-radius: 1.75rem;
	}
	.slide {
		scroll-snap-align: start;
		scroll-snap-stop: always;
		min-width: 0;
	}
	.slide__figura {
		height: 100%;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 3rem;
		padding: 3rem 3rem 1.5rem;
	}

	.slide__foto {
		--giro: 3deg;
		flex: none;
		width: 13.75rem;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		object-position: 50% 30%;
		border-width: 0.5rem 0.5rem 2rem;
	}
	.slide__foto--inicial {
		display: grid;
		place-items: center;
		background: var(--degradado-boton);
		background-clip: padding-box;
		font-size: 5.5rem;
		line-height: 1;
		color: var(--blanco);
	}

	.slide__texto {
		flex: 1 1 26rem;
		min-width: 0;
		display: grid;
		gap: 1rem;
		align-content: center;
	}
	.slide__comilla {
		height: 2.25rem;
		font-size: 6rem;
		line-height: 0.75;
		color: var(--magenta-claro);
	}
	.slide__cita {
		margin: 0;
		font-size: clamp(1.375rem, 2.6vw, 2rem);
		font-weight: 600;
		line-height: 1.3;
	}
	/* Sin frase destacada: el testimonio completo hace de cita, más chico y recortado */
	.slide__cita--larga {
		font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 6;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.slide__contexto {
		max-width: 42rem;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: rgb(255 255 255 / 0.72);
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.slide__habilidades {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.slide__habilidades .pill {
		font-size: 0.75rem;
		padding-block: 0.15rem;
	}
	.slide__autor {
		display: grid;
		font-size: 0.9375rem;
		line-height: 1.4;
	}
	.slide__autor span {
		color: var(--morado-claro);
	}

	/* Controles: contador y flechas, abajo a la derecha */
	.carrusel__controles {
		display: none;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		padding: 0 3rem 2rem;
	}
	[data-listo] .carrusel__controles {
		display: flex;
	}
	.carrusel__contador {
		margin-right: 0.5rem;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		font-variant-numeric: tabular-nums;
		color: var(--morado-claro);
	}
	.carrusel__boton {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.08);
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2);
		color: var(--blanco);
		cursor: pointer;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		transition: background 0.15s;
	}
	.carrusel__boton:hover:not(:disabled) {
		background: var(--degradado-boton);
		box-shadow: none;
	}
	.carrusel__boton:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.carrusel__boton svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	@media (max-width: 48rem) {
		.carrusel {
			border-radius: 1.25rem;
			box-shadow: none;
		}
		.carrusel__pista:focus-visible {
			border-radius: 1.25rem;
		}
		.slide__figura {
			display: grid;
			align-content: start;
			gap: 1rem;
			padding: 1.375rem 1.375rem 1rem;
		}
		.slide__foto {
			width: 8.75rem;
			border-width: 0.375rem 0.375rem 1.375rem;
		}
		.slide__foto--inicial {
			font-size: 3.5rem;
		}
		.slide__comilla {
			display: none;
		}
		.slide__cita {
			font-size: 1.375rem;
			line-height: 1.35;
		}
		.slide__cita::before {
			content: '“';
		}
		.slide__cita::after {
			content: '”';
		}
		.slide__cita--larga {
			font-size: 1.0625rem;
			-webkit-line-clamp: 7;
		}
		.slide__contexto {
			font-size: 0.875rem;
		}
		.slide__autor {
			font-size: 0.875rem;
		}
		.carrusel__controles {
			padding: 0 1.375rem 1.25rem;
		}
	}
</style>

<style>
  .mobile-hero {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    position: relative;
    z-index: 10;
    text-align: center;
    margin-top: -80px;
    background-image: url('/background.png');
    background-size: cover; /* Mantiene proporción y recorta lo que sobra */
    background-position: center;
    background-repeat: no-repeat;
    animation: pan-bg-left-right 30s ease-in-out infinite alternate;
    overflow: hidden;
  }

  /* Capa superpuesta premium con glassmorphism (UI/UX Pro Max) */
  .mobile-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    /* Reducida drásticamente la opacidad para que la imagen se vea más viva */
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.2) 100%);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: -1;
  }

  @keyframes pan-bg-left-right {
    0% { background-position: 0% 50%; } /* Izquierda */
    100% { background-position: 100% 50%; } /* Derecha */
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    max-width: 1000px; /* Aumentado de 600px a 1000px para que no sea tan compacto */
    width: 100%;
    animation: fade-up 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .badge-wrapper {
    margin-bottom: var(--space-2);
  }

  .light-badge {
    background: var(--stem-light);
    color: var(--stem-blue);
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .hero-title {
    font-size: clamp(38px, 10vw, 64px);
    line-height: 1.1;
    margin: 0;
    color: var(--text-dark);
  }

  .highlight.teal { color: var(--stem-blue); }
  .highlight.orange { color: var(--lead-gold); }

  .hero-desc {
    font-size: clamp(16px, 4vw, 20px);
    color: var(--text-body);
    line-height: 1.5;
    max-width: 90%;
    margin: 0;
    text-wrap: pretty;
  }

  .cta-wrapper {
    margin-top: var(--space-3);
    width: 100%;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    max-width: 320px;
    padding: 18px 32px;
    background: linear-gradient(135deg, var(--purple-dark), var(--magenta-pink));
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 18px;
    border-radius: 50px; /* Fully rounded */
    text-decoration: none;
    letter-spacing: 0.5px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 30px rgba(177, 74, 146, 0.3); /* Magenta shadow */
  }

  .btn-primary:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 40px rgba(177, 74, 146, 0.4);
  }

  .btn-primary:active {
    transform: scale(0.96);
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

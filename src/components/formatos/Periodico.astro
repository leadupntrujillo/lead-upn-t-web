---
import Cover from '../Cover.astro';
import PilarChip from '../PilarChip.astro';
import { fechaLarga, isoDia, minutosDeLectura } from '../../lib/format';
import Pie from './Pie.astro';
import type { FormatoProps } from './tipos';

/** Periódico: noticia completa. Titular, entradilla, foto ancha y una "columna" lateral con los datos. */
const { entry, pilar, autor, html, relacionadas, pilares } = Astro.props as FormatoProps;
const d = entry.data;
---

<article>
	<header class="contenedor cabeza">
		<PilarChip pilar={pilar} />
		<h1 class="titulo">{d.titulo}</h1>
		<p class="entradilla">{d.resumen}</p>
	</header>

	<figure class="contenedor portada">
		<Cover imagen={d.imagen} ratio="16 / 9" prioridad sizes="(min-width: 72rem) 72rem, 100vw" />
		{d.creditos && <figcaption class="creditos">{d.creditos}</figcaption>}
	</figure>

	<div class="contenedor cuerpo">
		<dl class="datos">
			<div>
				<dt>Publicado</dt>
				<dd><time datetime={isoDia(d.fechaPublicacion)}>{fechaLarga(d.fechaPublicacion)}</time></dd>
			</div>
			{
				autor && (
					<div>
						<dt>Por</dt>
						<dd>{autor.data.nombre}</dd>
					</div>
				)
			}
			<div>
				<dt>Lectura</dt>
				<dd>{minutosDeLectura(d.tiempoLectura)}</dd>
			</div>
		</dl>
		<div class="prose" set:html={html} />
	</div>
</article>

<Pie {entry} {autor} {relacionadas} {pilares} />

<style>
	.cabeza {
		display: grid;
		gap: 1rem;
		padding-top: clamp(2rem, 5vw, 3.5rem);
		padding-bottom: 1.75rem;
	}
	.cabeza :global(.chip) {
		justify-self: start;
	}
	h1 {
		max-width: 60rem;
		font-size: clamp(2.5rem, 7vw, 5rem);
		line-height: 1.05;
	}
	.entradilla {
		max-width: 44rem;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.55;
		font-weight: 400;
		color: var(--tinta-suave);
	}
	.portada {
		margin-block: 0 2.5rem;
	}
	.cuerpo {
		display: grid;
		gap: 1.5rem 3rem;
	}
	@media (min-width: 64rem) {
		.cuerpo {
			grid-template-columns: 13rem minmax(0, 1fr);
		}
		.datos {
			position: sticky;
			top: 5.5rem;
			align-self: start;
		}
	}
	/* Columna lateral: los datos de la nota, como en un diario */
	.datos {
		display: grid;
		gap: 0.9rem;
		margin: 0;
		padding-top: 0.9rem;
		border-top: 3px solid var(--marino);
		font-size: 0.9rem;
	}
	.datos div {
		display: grid;
	}
	dt {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--tinta-suave);
	}
	dd {
		margin: 0;
		font-weight: 600;
	}
</style>

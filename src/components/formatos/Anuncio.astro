---
import PilarChip from '../PilarChip.astro';
import { fechaLarga, isoDia } from '../../lib/format';
import Pie from './Pie.astro';
import type { FormatoProps } from './tipos';

/** Anuncio: aviso corto e importante. Bloque marino con el mensaje y una "carta" con el detalle. */
const { entry, pilar, autor, html, relacionadas, pilares } = Astro.props as FormatoProps;
const d = entry.data;
---

<article>
	<header class="aviso">
		<div class="contenedor aviso__fila">
			<span class="caja aviso__caja titulo">Anuncio</span>
			<h1 class="titulo">{d.titulo}</h1>
			<p class="aviso__resumen">{d.resumen}</p>
			<p class="aviso__meta">
				<time class="pill pill--oscuro" datetime={isoDia(d.fechaPublicacion)}>{fechaLarga(d.fechaPublicacion)}</time>
				<PilarChip pilar={pilar} oscuro />
			</p>
		</div>
	</header>

	<div class="contenedor carta-envoltura">
		<div class="carta">
			<div class="prose" set:html={html} />
			<p class="firma">
				{autor ? autor.data.nombre : 'Equipo LEAD UPN Trujillo'}
				{pilar && !autor && <span>, {pilar.data.nombre}</span>}
			</p>
		</div>
	</div>
</article>

<Pie {entry} {autor} {relacionadas} {pilares} sinAutor />

<style>
	.aviso {
		background:
			radial-gradient(70% 120% at 100% 0%, rgb(140 63 209 / 0.4), transparent 65%),
			var(--marino);
		color: var(--blanco);
		padding-block: clamp(2.5rem, 7vw, 5rem) clamp(4rem, 9vw, 6rem);
	}
	.aviso__fila {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
	}
	.aviso__caja {
		font-size: 1.25rem;
		padding: 0.1em 0.4em;
	}
	h1 {
		max-width: 20ch;
		font-size: clamp(2.6rem, 8vw, 5.5rem);
		line-height: 1.04;
	}
	.aviso__resumen {
		max-width: 40rem;
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.55;
		color: rgb(255 255 255 / 0.88);
	}
	.aviso__meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}
	/* La carta sube sobre el bloque marino */
	.carta-envoltura {
		margin-top: -2.5rem;
	}
	.carta {
		max-width: 46rem;
		padding: clamp(1.5rem, 4vw, 2.75rem);
		background: var(--blanco);
		border-top: 6px solid transparent;
		border-image: var(--degradado) 1;
		box-shadow: var(--sombra);
	}
	.firma {
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--linea);
		font-weight: 700;
	}
	.firma span {
		font-weight: 400;
		color: var(--tinta-suave);
	}
</style>

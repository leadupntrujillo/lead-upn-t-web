---
import PilarChip from '../PilarChip.astro';
import { diasRestantes, fechaLarga } from '../../lib/format';
import Pie from './Pie.astro';
import type { FormatoProps } from './tipos';

/** Convocatoria: búsqueda de postulantes. Lo primero es el estado (abierta o cerrada) y la fecha límite. */
const { entry, pilar, autor, html, relacionadas, pilares } = Astro.props as FormatoProps;
const d = entry.data;
const limite = d.fechaEvento;

const dias = limite ? diasRestantes(limite.inicio, new Date(), limite.conHora) : null;
const cerrada = dias !== null && dias < 0;
const textoDias = (n: number) => (n < 0 ? 'Convocatoria cerrada' : n === 0 ? 'Cierra hoy' : n === 1 ? 'Cierra mañana' : `Faltan ${n} días`);
---

<article>
	<header class="cabeza">
		<div class="contenedor cabeza__fila">
			<PilarChip pilar={pilar} oscuro />
			<h1 class="titulo">{d.titulo}</h1>
			<p class="cabeza__resumen">{d.resumen}</p>

			<div class="cierre">
				{
					limite ? (
						<>
							<p
								class:list={['cierre__estado', 'pill', cerrada ? 'pill--oscuro' : 'caja-estado']}
								data-limite={limite.inicio.toISOString()}
								data-con-hora={String(limite.conHora)}
							>
								<span class="cierre__punto" aria-hidden="true" />
								<span data-texto-dias>{textoDias(dias!)}</span>
							</p>
							<p class="cierre__fecha">
								Fecha límite: <strong>{fechaLarga(limite.inicio, limite.conHora)}</strong>
							</p>
						</>
					) : (
						<p class="pill pill--oscuro">Fecha límite por confirmar</p>
					)
				}
				{
					d.boton && !cerrada && (
						<a class="btn btn--primario" href={d.boton.url} rel="noopener noreferrer" target="_blank">
							{d.boton.texto}
						</a>
					)
				}
			</div>
		</div>
	</header>

	<div class="lectura cuerpo">
		<div class="prose" set:html={html} />
	</div>
</article>

<Pie {entry} {autor} {relacionadas} {pilares} sinBoton={!cerrada} />

<!-- En móvil el botón queda fijo abajo mientras la convocatoria está abierta -->
{
	d.boton && !cerrada && (
		<div class="barra-fija">
			<a class="btn btn--primario" href={d.boton.url} rel="noopener noreferrer" target="_blank">
				{d.boton.texto}
			</a>
		</div>
	)
}

<script>
	// El conteo de días se recalcula en el navegador: la página puede llevar días publicada.
	const hoyLima = (): number => Date.parse(new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Lima' }).format(new Date()));
	const texto = (n: number) =>
		n < 0 ? 'Convocatoria cerrada' : n === 0 ? 'Cierra hoy' : n === 1 ? 'Cierra mañana' : `Faltan ${n} días`;

	document.querySelectorAll<HTMLElement>('[data-limite]').forEach((el) => {
		const limite = new Date(el.dataset.limite!);
		const zona = el.dataset.conHora === 'true' ? 'America/Lima' : 'UTC';
		const finDia = Date.parse(new Intl.DateTimeFormat('en-CA', { timeZone: zona }).format(limite));
		const dias = Math.round((finDia - hoyLima()) / 86_400_000);
		const destino = el.querySelector('[data-texto-dias]');
		if (destino) destino.textContent = texto(dias);
		el.classList.toggle('pill--oscuro', dias < 0);
		el.classList.toggle('caja-estado', dias >= 0);
	});
</script>

<style>
	.cabeza {
		background:
			radial-gradient(60% 110% at 0% 0%, rgb(214 41 122 / 0.35), transparent 60%),
			radial-gradient(70% 120% at 100% 100%, rgb(140 63 209 / 0.4), transparent 60%),
			var(--marino);
		color: var(--blanco);
		padding-block: clamp(2.5rem, 7vw, 4.5rem);
	}
	.cabeza__fila {
		display: grid;
		gap: 1.25rem;
		justify-items: start;
	}
	h1 {
		max-width: 22ch;
		font-size: clamp(2.5rem, 7vw, 4.75rem);
		line-height: 1.05;
	}
	.cabeza__resumen {
		max-width: 40rem;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.55;
		color: rgb(255 255 255 / 0.88);
	}
	.cierre {
		display: flex;
		align-items: center;
		gap: 1rem 1.5rem;
		flex-wrap: wrap;
		margin-top: 0.5rem;
	}
	.cierre__estado {
		font-size: 0.95rem;
		padding: 0.4rem 1rem;
	}
	.caja-estado {
		background: var(--blanco);
		color: var(--marino);
	}
	.cierre__punto {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--magenta);
	}
	.cierre__fecha {
		font-size: 1rem;
	}
	.cuerpo {
		padding-block: clamp(2rem, 5vw, 3.5rem) 0;
		margin-inline: max(var(--gutter), calc((100% - var(--ancho)) / 2));
		width: auto;
		max-width: var(--lectura);
	}
	.barra-fija {
		position: sticky;
		bottom: 0;
		z-index: 40;
		padding: 0.75rem var(--gutter);
		background: rgb(246 245 251 / 0.92);
		backdrop-filter: blur(8px);
		border-top: 1px solid var(--linea);
	}
	.barra-fija .btn {
		width: 100%;
	}
	@media (min-width: 48rem) {
		.barra-fija {
			display: none;
		}
	}
</style>

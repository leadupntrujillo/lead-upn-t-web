---
import Cover from '../Cover.astro';
import PilarChip from '../PilarChip.astro';
import { fechaLarga, isoDia } from '../../lib/format';
import Pie from './Pie.astro';
import type { FormatoProps } from './tipos';

/** Galería: fotorreportaje. Poco texto y una cuadrícula de fotos que se abren en grande. */
const { entry, pilar, autor, html, relacionadas, pilares } = Astro.props as FormatoProps;
const d = entry.data;
const fotos = [...d.galeria];
if (d.imagen && !fotos.some((f) => f.src === d.imagen!.src)) fotos.unshift(d.imagen);
const esVistaPrevia = d.estado !== 'publicado';
---

<article>
	<header class="contenedor cabeza">
		<PilarChip pilar={pilar} />
		<h1 class="titulo">{d.titulo}</h1>
		<p class="meta">
			<time datetime={isoDia(d.fechaPublicacion)}>{fechaLarga(d.fechaPublicacion)}</time>
			{fotos.length > 0 && <span class="pill">{fotos.length} fotos</span>}
		</p>
	</header>

	<div class="lectura intro">
		<div class="prose" set:html={html} />
	</div>

	<section class="contenedor" aria-label="Fotos">
		{
			fotos.length > 0 ? (
				<ul class="mosaico">
					{fotos.map((f, i) => (
						<li>
							<button type="button" class="foto" data-indice={i} aria-label={`Ampliar foto ${i + 1} de ${fotos.length}`}>
								<img src={f.src} alt={f.alt} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
							</button>
						</li>
					))}
				</ul>
			) : (
				esVistaPrevia && (
					<div class="muestra">
						<ul class="mosaico mosaico--muestra" aria-hidden="true">
							{[0, 1, 2, 3, 4, 5].map(() => (
								<li>
									<Cover imagen={null} ratio="4 / 3" />
								</li>
							))}
						</ul>
						<p class="vacio">Esta galería aún no tiene fotos. Agrégalas en el campo “Galería” de la novedad en Notion (se recomiendan 4 o más).</p>
					</div>
				)
			)
		}
	</section>

	<dialog class="visor" aria-label="Foto ampliada">
		<form method="dialog" class="visor__barra">
			<p class="visor__cuenta" aria-live="polite"></p>
			<button class="visor__cerrar" aria-label="Cerrar">Cerrar</button>
		</form>
		<img class="visor__img" alt="" />
		<div class="visor__nav">
			<button type="button" data-ir="-1" aria-label="Foto anterior">Anterior</button>
			<button type="button" data-ir="1" aria-label="Foto siguiente">Siguiente</button>
		</div>
	</dialog>
</article>

<Pie {entry} {autor} {relacionadas} {pilares} />

<script is:inline define:vars={{ fotos }}>
	const visor = document.querySelector('dialog.visor');
	if (visor && fotos.length) {
		const img = visor.querySelector('.visor__img');
		const cuenta = visor.querySelector('.visor__cuenta');
		let actual = 0;
		const mostrar = (i) => {
			actual = (i + fotos.length) % fotos.length;
			img.src = fotos[actual].src;
			img.alt = fotos[actual].alt;
			cuenta.textContent = `${actual + 1} de ${fotos.length}`;
		};
		document.querySelectorAll('.foto').forEach((b) =>
			b.addEventListener('click', () => {
				mostrar(Number(b.dataset.indice));
				visor.showModal();
			}),
		);
		visor.querySelectorAll('[data-ir]').forEach((b) => b.addEventListener('click', () => mostrar(actual + Number(b.dataset.ir))));
		visor.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') mostrar(actual + 1);
			if (e.key === 'ArrowLeft') mostrar(actual - 1);
		});
		// Un clic fuera de la foto también cierra el visor
		visor.addEventListener('click', (e) => {
			if (e.target === visor) visor.close();
		});
	}
</script>

<style>
	.cabeza {
		display: grid;
		gap: 1rem;
		padding-block: clamp(2rem, 5vw, 3.5rem) 1.5rem;
		justify-items: start;
	}
	h1 {
		font-size: clamp(2.5rem, 7vw, 4.75rem);
		line-height: 1.05;
		max-width: 20ch;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--tinta-suave);
	}
	.intro {
		margin-inline: max(var(--gutter), calc((100% - var(--ancho)) / 2));
		width: auto;
		max-width: var(--lectura);
		margin-bottom: 2rem;
	}
	.mosaico {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 3 14rem;
		column-gap: 0.75rem;
	}
	.mosaico li {
		break-inside: avoid;
		margin-bottom: 0.75rem;
	}
	.foto {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
		overflow: hidden;
		border-radius: 0.4rem;
	}
	.foto img {
		width: 100%;
		height: auto;
		transition: transform 0.3s;
	}
	.foto:hover img {
		transform: scale(1.03);
	}
	.muestra {
		display: grid;
		gap: 1rem;
	}

	/* Visor */
	.visor {
		width: min(100vw, 70rem);
		max-width: 100vw;
		max-height: 100dvh;
		margin: auto;
		padding: 1rem;
		border: 0;
		background: transparent;
		color: var(--blanco);
	}
	.visor::backdrop {
		background: rgb(11 14 51 / 0.92);
	}
	.visor__barra,
	.visor__nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin: 0;
	}
	.visor__img {
		width: 100%;
		max-height: 78dvh;
		object-fit: contain;
		margin-block: 0.75rem;
	}
	.visor button {
		padding: 0.5rem 1.1rem;
		border: 0;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.14);
		color: inherit;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.visor button:hover {
		background: rgb(255 255 255 / 0.25);
	}
</style>

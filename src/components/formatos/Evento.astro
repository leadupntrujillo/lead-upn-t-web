---
import Cover from '../Cover.astro';
import PilarChip from '../PilarChip.astro';
import { fechaConDia, hora, partesDeFecha } from '../../lib/format';
import Pie from './Pie.astro';
import type { FormatoProps } from './tipos';

/** Evento: invitación a algo que va a pasar. Cuerpo a la izquierda y una "ficha" fija con fecha, lugar y botón. */
const { entry, pilar, autor, html, relacionadas, pilares } = Astro.props as FormatoProps;
const d = entry.data;
const ev = d.fechaEvento;
const partes = ev ? partesDeFecha(ev.inicio, ev.conHora) : null;
const modalidades = { presencial: 'Presencial', virtual: 'Virtual', hibrido: 'Híbrido' } as const;

// "Sábado, 5 de diciembre, 6:00 p. m. a 8:00 p. m."
const cuando = ev
	? [
			fechaConDia(ev.inicio, ev.conHora),
			ev.conHora ? (ev.fin ? `${hora(ev.inicio)} a ${hora(ev.fin)}` : hora(ev.inicio)) : null,
		]
			.filter(Boolean)
			.join(', ')
			.replace(/^./, (c) => c.toUpperCase())
	: null;

const mapa = d.lugar
	? d.lugar.lat !== null && d.lugar.lng !== null
		? `https://www.google.com/maps/search/?api=1&query=${d.lugar.lat},${d.lugar.lng}`
		: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${d.lugar.nombre} ${d.lugar.direccion}`.trim())}`
	: null;
---

<article>
	<header class="contenedor cabeza">
		<PilarChip pilar={pilar} />
		<h1 class="titulo">{d.titulo}</h1>
		<p class="entradilla">{d.resumen}</p>
	</header>

	<div class="contenedor grilla">
		<div class="principal">
			<Cover imagen={d.imagen} ratio="16 / 9" prioridad />
			<div class="prose" set:html={html} />
		</div>

		<aside class="ficha" aria-label="Datos del evento">
			{
				partes ? (
					<div class="ficha__fecha">
						<span class="ficha__dia">{partes.dia}</span>
						<span class="ficha__resto">
							<span class="ficha__mes">{partes.mes}</span>
							<span>{partes.anio}</span>
						</span>
					</div>
				) : (
					<p class="ficha__pendiente">Fecha por confirmar</p>
				)
			}

			<dl class="ficha__datos">
				{
					cuando && (
						<div>
							<dt>Cuándo</dt>
							<dd>{cuando}</dd>
						</div>
					)
				}
				{
					d.modalidad && (
						<div>
							<dt>Modalidad</dt>
							<dd>{modalidades[d.modalidad]}</dd>
						</div>
					)
				}
				{
					d.lugar && (
						<div>
							<dt>Dónde</dt>
							<dd>
								{d.lugar.nombre}
								{d.lugar.direccion && <span class="ficha__dir">{d.lugar.direccion}</span>}
								{mapa && (
									<a class="ficha__mapa" href={mapa} target="_blank" rel="noopener noreferrer">
										Cómo llegar
									</a>
								)}
							</dd>
						</div>
					)
				}
			</dl>

			{
				d.boton && (
					<a class="btn btn--primario ficha__boton" href={d.boton.url} rel="noopener noreferrer" target="_blank">
						{d.boton.texto}
					</a>
				)
			}
		</aside>
	</div>
</article>

<Pie {entry} {autor} {relacionadas} {pilares} sinBoton />

<style>
	.cabeza {
		display: grid;
		gap: 1rem;
		padding-block: clamp(2rem, 5vw, 3.5rem) 2rem;
	}
	.cabeza :global(.chip) {
		justify-self: start;
	}
	h1 {
		max-width: 56rem;
		font-size: clamp(2.5rem, 7vw, 4.75rem);
		line-height: 1.05;
	}
	.entradilla {
		max-width: 42rem;
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		font-weight: 500;
		color: var(--tinta-suave);
	}
	.grilla {
		display: grid;
		gap: 2rem;
		align-items: start;
	}
	@media (min-width: 62rem) {
		.grilla {
			grid-template-columns: minmax(0, 1fr) 21rem;
			gap: 3rem;
		}
		.ficha {
			position: sticky;
			top: 5.5rem;
		}
	}
	.principal {
		display: grid;
		gap: 2rem;
	}
	.principal :global(.cover) {
		border-radius: 0.5rem;
	}

	/* Ficha del evento */
	.ficha {
		display: grid;
		gap: 1.4rem;
		padding: 1.5rem;
		border-radius: 1rem;
		background: var(--marino);
		color: var(--blanco);
		box-shadow: var(--sombra);
	}
	.ficha__fecha {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		line-height: 1;
	}
	.ficha__dia {
		font-family: var(--f-display);
		font-size: 4.5rem;
	}
	.ficha__resto {
		display: grid;
		gap: 0.2rem;
		font-size: 1rem;
		font-weight: 600;
	}
	.ficha__mes {
		font-size: 1.3rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--coral-claro);
	}
	.ficha__pendiente {
		font-family: var(--f-display);
		font-size: 1.8rem;
		text-transform: uppercase;
	}
	.ficha__datos {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding-top: 1.2rem;
		border-top: 1px solid rgb(255 255 255 / 0.18);
	}
	.ficha dt {
		font-size: 0.78rem;
		font-weight: 600;
		color: rgb(255 255 255 / 0.7);
	}
	.ficha dd {
		margin: 0;
		font-weight: 600;
		line-height: 1.45;
	}
	.ficha__dir {
		display: block;
		font-weight: 400;
		font-size: 0.9rem;
		color: rgb(255 255 255 / 0.8);
	}
	.ficha__mapa {
		display: inline-block;
		margin-top: 0.4rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--magenta-claro);
	}
	.ficha__boton {
		width: 100%;
	}
</style>

---
// Solo tres pesos de Poppins (400, 600 y 700) y Anton: menos archivos que descargar.
import '@fontsource/anton/400.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';
import '../styles/prose.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo, { type SeoProps } from '../components/Seo.astro';
import { getSitio } from '../lib/queries';

interface Props extends SeoProps {
	/** Alias de `titulo` (compatibilidad con las páginas existentes). */
	title?: string;
	/** Alias de `descripcion`. */
	description?: string;
	/** Texto del estado cuando la página es una vista previa (Borrador, En revisión). */
	vistaPrevia?: string | null;
}

const { title, description, vistaPrevia = null, titulo = title, descripcion = description, noindex, ...seo } = Astro.props;
const sitio = await getSitio();
---

<!doctype html>
<html lang="es-PE">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" content="#161a4e" />
		<meta name="color-scheme" content="light" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<Seo {sitio} {titulo} {descripcion} noindex={noindex || Boolean(vistaPrevia)} {...seo} />
		<slot name="head" />
	</head>
	<body>
		<a class="saltar" href="#contenido">Saltar al contenido</a>
		{
			vistaPrevia && (
				<div class="vista-previa" role="status">
					Vista previa: {vistaPrevia}. Esta novedad no es pública todavía.
				</div>
			)
		}
		<Header {sitio} />
		<main id="contenido">
			<slot />
		</main>
		<Footer {sitio} />
	</body>
</html>

<style>
	.vista-previa {
		background: #fdf3cc;
		color: #5c4300;
		text-align: center;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.5rem var(--gutter);
	}
</style>
